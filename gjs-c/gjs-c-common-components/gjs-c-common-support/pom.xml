<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.gjsoft.c</groupId>
		<artifactId>gjs-c-lib-parent</artifactId>
		<version>1.0.0-RC.2</version>
		<relativePath>../../gjs-c-parents/gjs-c-lib-parent</relativePath>
	</parent>	

	<groupId>org.gjsoft.c.common</groupId>
	<artifactId>gjs-c-common-support</artifactId>
	<packaging>nar</packaging>

	<name>GJS C Common Support</name>
	<description>Base type components and tools for C project archetypes</description>

	<properties>
		<checkSeverity>style</checkSeverity>	
	</properties>

    <dependencies>
		<dependency>
			<groupId>org.gjsoft.c.common</groupId>
			<artifactId>gjs-c-common-base</artifactId>
			<type>nar</type>
		</dependency>
		<dependency>
			<groupId>org.gjsoft.c.common</groupId>
			<artifactId>gjs-c-common-base-types</artifactId>
			<type>nar</type>
		</dependency>
		<dependency>
			<groupId>org.gjsoft.c.common</groupId>
			<artifactId>gjs-c-common-text</artifactId>
			<type>nar</type>
		</dependency>
		<dependency>
			<groupId>org.gjsoft.c.common</groupId>
			<artifactId>gjs-c-common-time</artifactId>
			<type>nar</type>
		</dependency>
		<dependency>
			<groupId>org.gjsoft.c.common</groupId>
			<artifactId>gjs-c-common-io</artifactId>
			<type>nar</type>
		</dependency>
		<dependency>
			<groupId>org.gjsoft.c.common</groupId>
			<artifactId>gjs-c-common-system</artifactId>
			<type>nar</type>
		</dependency>
    </dependencies>

	<profiles>
		<profile>
			<id>runtime-posix</id>
			<activation>
                <property>
					<name>environment.style</name>
					<value>posix</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.gjsoft.maven.plugins</groupId>
						<artifactId>nar-maven-plugin</artifactId>
						<configuration>
							<linker>
								<libs combine.children="append">
									<lib>
										<name>ncurses</name>
										<type>shared</type>
										<directory>${cpp.dir.lib.system}</directory>
									</lib>
								</libs>					
							</linker>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>