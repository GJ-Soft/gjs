<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.gjs.c</groupId>
		<artifactId>gjs-c-lib-parent</artifactId>
		<version>1.0.0-RC.1</version>
		<relativePath>../../gjs-c-parents/gjs-c-lib-parent</relativePath>
	</parent>	

	<groupId>org.gjs.c.common</groupId>
	<artifactId>gjs-c-common-system</artifactId>
	<packaging>nar</packaging>

	<name>GJS C Common System Support</name>
	<description>Base type components for C project archetypes</description>

	<properties>
		<checkSeverity>style</checkSeverity>	
	</properties>

    <dependencies>
		<dependency>
			<groupId>org.gjs.c.common</groupId>
			<artifactId>gjs-c-common-text</artifactId>
			<type>nar</type>
		</dependency>
		<dependency>
			<groupId>org.gjs.c.common</groupId>
			<artifactId>gjs-c-common-calculation</artifactId>
			<type>nar</type>
		</dependency>
		<dependency>
			<groupId>org.gjs.c.common</groupId>
			<artifactId>gjs-c-common-time</artifactId>
			<type>nar</type>
		</dependency>
		<dependency>
			<groupId>org.gjs.c.common</groupId>
			<artifactId>gjs-c-common-types</artifactId>
			<type>nar</type>
		</dependency>
		<dependency>
			<groupId>org.gjs.c.common</groupId>
			<artifactId>gjs-c-common-io</artifactId>
			<type>nar</type>
		</dependency>
    </dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>com.github.maven-nar</groupId>
				<artifactId>nar-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>cygwin-win</id>
			<activation>
				<property>
					<name>cygwin.style</name>
					<value>windows</value>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>com.github.maven-nar</groupId>
						<artifactId>nar-maven-plugin</artifactId>
						<configuration>
							<linker>
								<libs combine.children="append">
									<lib>
										<name>netapi32</name>
										<type>shared</type>
										<directory>${cygwin-windows.dir.lib.system}</directory>
									</lib>
									<lib>
										<name>psapi</name>
										<type>shared</type>
										<directory>${cygwin-windows.dir.lib.system}</directory>
									</lib>
									<lib>
										<name>gdi32</name>
										<type>shared</type>
										<directory>${cygwin-windows.dir.lib.system}</directory>
									</lib>
									<lib>
										<name>comdlg32</name>
										<type>shared</type>
										<directory>${cygwin-windows.dir.lib.system}</directory>
									</lib>
								</libs>					
							</linker>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>