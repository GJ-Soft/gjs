<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.gjsoft.c</groupId>
		<artifactId>gjs-c-nar-extension-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../gjs-c-nar-extension-parent</relativePath>
	</parent>

    <artifactId>gjs-c-nar-parent</artifactId>
	<packaging>pom</packaging>

	<name>Maven C/C++ NAR Parent Pom</name>
	<description>
	Parent pom for compiling and linking C/C++ projects using the nar-maven-plugin.
	To compile C files with the C++ compiler, you can use the .cc extension.
		.
		.	Pom organization:
		.
		.	gjs-parent
		.	   └── gjs-no-java-parent
		.				└── gjs-c-common-parent
		.						   └── gjs-c-nar-extension-parent
		.									└── gjs-c-nar-parent
		.											   ├── gjs-c-parent
		.											   │          ├── gjs-c-lib-parent
		.											   │          ├── gjs-c-stlib-parent
		.											   │          └── gjs-c-exe-parent
		.											   └── gjs-cpp-parent
		.														  ├── gjs-cpp-lib-parent
		.														  ├── gjs-cpp-stlib-parent
		.													  	  └── gjs-cpp-exe-parent
		.
	</description>
	<properties>
		<!-- Generic compilation options-->
		<gjs.nar.architecture.bits>64</gjs.nar.architecture.bits>
		<!-- none=none, size=-Os, speed=-O1, full=-O2, extreme=-O3 -->
		<gjs.nar.optimization>full</gjs.nar.optimization>
		
		<!-- Optinal specific compilation options -->
		<gjs.nar.locale.option>-DWITH_NO_C_LOCALE</gjs.nar.locale.option>
		<gjs.nar.openssl.option>-DWITH_OPENSSL</gjs.nar.openssl.option>

		<!-- Enganche para opciones extra del compilador. Se usa en los bloques
		     <c> y <cpp> de mas abajo; vacio por defecto, lo rellenan los perfiles
		     (ver el perfil 'debug'). Sin esta declaracion la propiedad quedaba
		     sin resolver. -->
		<gjs.compiler.additionalOptions></gjs.compiler.additionalOptions>
		
		<!-- Aggregational platform specific compilation options -->
		<gjs.nar.platform.options>${platformOptions}</gjs.nar.platform.options>
		<!-- Hueco para ${platformLinkOptions}: hoy no esta conectado, por eso queda
		     vacio. Si algun dia se usa, ojo con el contenido: tienen que ser opciones
		     del DRIVER de gcc, no del enlazador. Envueltas en -Wl, llegan a ld, que
		     lee -m como emulacion y aborta ( "unrecognised emulation mode: cygwin",
		     comprobado con binutils 2.46.1, que solo admite i386pep e i386pe ). La
		     emulacion ya la pone gjs.nar.emulation.option, en la linea de arriba. -->
		<gjs.nar.platform.link.options></gjs.nar.platform.link.options>

		<!-- Default Compiler options (must be defined in the pom.xml son) -->
		<gjs.nar.compiler/>
		<gjs.nar.linker/>
		<gjs.nar.compiler.language/>
		<gjs.nar.language.version/>
		<gjs.nar.language.standard/>

		<!-- Platform options -->	
		
		<!-- Threads -->
		<gjs.nar.threads.option>-pthread</gjs.nar.threads.option>

		<!-- Linker options -->	
		<gjs.nar.emulation.option>-Wl,-m,${gjs.nar.emulation}</gjs.nar.emulation.option> 
		
		<!-- Nar build directories -->
		<gjs.nar.build.directory>${project.build.directory}/nar</gjs.nar.build.directory>
		<gjs.nar.build.testDirectory>${project.build.directory}/test-nar</gjs.nar.build.testDirectory>
		<gjs.nar.build.testReportsDirectory>${gjs.nar.build.testDirectory}/test-reports</gjs.nar.build.testReportsDirectory>
		
		<!-- Naming -->
		<finalName.prefix.lib>lib</finalName.prefix.lib>
		<finalName.prefix.exe></finalName.prefix.exe>
		<finalName.prefix></finalName.prefix>
		<finalName>${finalName.prefix}${project.artifactId}-${project.version}</finalName>

		<!-- CppChek values -->
		<cpp.language.standard>${gjs.nar.language.standard}</cpp.language.standard>
		<cpp.compiler>${gjs.nar.compiler}</cpp.compiler>
		<cpp.compiler.language>${gjs.nar.compiler.language}</cpp.compiler.language>

		<!-- GCovr values -->	
		<!-- OJO: /usr/bin es un montaje virtual de Cygwin sobre /bin, no existe como
		     directorio visto desde Windows. El fichero real esta en ${cygwinDir}/bin. -->
		<cpp.gcovr>${cygwinDir}/bin/gcovr</cpp.gcovr>
		<cpp.gcovr.dir>${gjs.nar.build.testDirectory}</cpp.gcovr.dir>
		<!-- El informe, donde lo deja JaCoCo en Java y el perfil cobertura en Python. -->
		<cpp.gcovr.target>${project.build.directory}/site/coverage</cpp.gcovr.target>
		<cpp.gcovr.exe>Test${exeFinalExtension}</cpp.gcovr.exe>
		<!-- Raiz de fuentes de gcovr (-r): los ficheros del informe se nombran
		     relativos a ella, y ademas hace de filtro por defecto, con lo que deja
		     fuera las cabeceras del sistema. No es el binario de test: gcovr no
		     ejecuta nada, solo lee los .gcda/.gcno del directorio de trabajo. -->
		<cpp.gcovr.root>${project.basedir}</cpp.gcovr.root>
		<!-- gcovr es un script de Python (shebang #!/usr/bin/python3.9.exe), no un
		     ejecutable: Ant lanza con CreateProcess, que no interpreta shebangs, asi
		     que hay que invocarlo con su interprete. Tiene que ser el Python 3.9 de
		     Cygwin, que es donde esta instalado el modulo gcovr; el de Windows no lo
		     tiene. -->
		<cpp.gcovr.python>${cygwinDir}/bin/python3.9.exe</cpp.gcovr.python>
		<!-- Ese Python es POSIX: no reconoce C:\... ni C:/... como rutas absolutas y
		     las concatena al directorio de trabajo. Todas las rutas que reciba se
		     convierten antes con cygpath -u, con el ${cpp.cygpath} que hereda de
		     gjs-c-common-parent (alli lo necesita doxygen por lo mismo). -->
	</properties>

	<build>	
		<pluginManagement>				
			<plugins>
				<plugin>
					<groupId>org.gjsoft.maven.plugins</groupId>
					<artifactId>nar-maven-plugin</artifactId>
					<configuration>
						<os>${osName}</os>
						<architecture>${gjs.nar.architecture}</architecture>
						<resourceDirectory>${project.basedir}/src/main/resources</resourceDirectory>

						<gnuUseOnWindows>true</gnuUseOnWindows>
						<gnuMakeSkip>true</gnuMakeSkip>
						<!--output>${finalName}</output-->
						<c>
							<name>${gjs.nar.compiler}</name>							
							<prefix>${gjs.nar.toolchain.prefix}</prefix>
							<debug>false</debug>
							<sourceDirectory>${project.basedir}/src/main/${gjs.nar.compiler.language}</sourceDirectory>
							<includes>
								<include>**/*.c</include>
							</includes>
							<excludes>
								<exclude>**/*.cxx</exclude>
								<exclude>**/*.cc</exclude>
								<exclude>**/*.cpp</exclude>
								<exclude>**/*.hpp</exclude>
								<exclude>**/*.txt</exclude>
								<exclude>**/*.md</exclude>
								<exclude>**/*.sql</exclude>
								<exclude>**/resources/**</exclude>
							</excludes>						
							<ccache>false</ccache>
							<languageStandard>${gjs.nar.language.standard}</languageStandard>   
							<bitsArchitecture>${gjs.nar.architecture.bits}</bitsArchitecture>
							<multiThreaded>true</multiThreaded>
							<threadFlag>${gjs.nar.threads.option}</threadFlag>
							<optimize>${gjs.nar.optimization}</optimize>
						
							<options>
								<option>-fPIC</option> 
								<option>-fabi-version=0</option>
								<option>-Wall</option> 
								<option>-Wno-switch</option> 
								<option>-Wno-sign-compare</option> 
								<option>-Wno-pointer-arith</option>
								<option>-Wno-write-strings</option>
								<option>-Wunused-result</option>
								<option>${gjs.nar.locale.option}</option>
								<option>${gjs.nar.platform.options}</option>
								<option>${gjs.compiler.additionalOptions}</option>
							</options>

							<includePaths>
								<includePath>
									<path>${project.basedir}/src/main/include</path>
								</includePath>
							</includePaths>						
						</c>
						<cpp>
							<name>${gjs.nar.compiler}</name>							
							<prefix>${gjs.nar.toolchain.prefix}</prefix>
							<debug>false</debug>
							<sourceDirectory>${project.basedir}/src/main/${gjs.nar.compiler.language}</sourceDirectory>
							<includes>
								<include>**/*.cxx</include>
								<include>**/*.cc</include>
								<include>**/*.cpp</include>
								<include>**/*.hpp</include>
							</includes>
							<excludes>
								<exclude>**/*.c</exclude>
								<exclude>**/*.txt</exclude>
								<exclude>**/*.md</exclude>
								<exclude>**/*.sql</exclude>
								<exclude>**/resources/**</exclude>
							</excludes>						
							<ccache>false</ccache>
							<languageStandard>${gjs.nar.language.standard}</languageStandard>   
							<bitsArchitecture>${gjs.nar.architecture.bits}</bitsArchitecture>
							<multiThreaded>true</multiThreaded>
							<threadFlag>${gjs.nar.threads.option}</threadFlag>
							<optimize>${gjs.nar.optimization}</optimize>
						
							<options>
								<option>-fPIC</option> 
								<option>-fabi-version=0</option>
								<option>-Wall</option> 
								<option>-Wno-switch</option> 
								<option>-Wno-sign-compare</option> 
								<option>-Wno-pointer-arith</option>
								<option>-Wno-write-strings</option>
								<option>-Wunused-result</option>
								<option>${gjs.nar.locale.option}</option>
								<option>${gjs.nar.platform.options}</option>
								<option>${gjs.compiler.additionalOptions}</option>
							</options>

							<includePaths>
								<includePath>
									<path>${project.basedir}/src/main/include</path>
								</includePath>
							</includePaths>						
						</cpp>
						
						<linker>
							<name>${gjs.nar.linker}</name>
							<prefix>${gjs.nar.toolchain.prefix}</prefix>
							<!-- Donde viven las DLL/.so del propio toolchain (libstdc++, libgcc,
							     libwinpthread). No interviene en el enlazado: el plugin lo anade al
							     PATH con el que lanza los tests y los ejecutables, que si no arrancan
							     ni llegan a dar un error legible (en Windows, 0xC0000135 a secas).
							     Hasta ahora solo llegaba de rebote, por el <binDirectory> de alguna
							     <lib> externa, asi que los modulos sin librerias externas fallaban.
							     Si el directorio no existe ( Cygwin, Linux ) se ignora. -->
							<runtimeDirectory>${cpp.dir.lib.runtime}</runtimeDirectory>
							<incremental>false</incremental>
							
							<options>
								<option>-v</option> 
								<option>${gjs.nar.emulation.option}</option> 
								<option>${gjs.nar.platform.link.options}</option>
								<option>${gjs.nar.threads.option}</option>
							</options>
							<!-- Vacio a proposito. Linker.getTestLinker parte de la configuracion
							     de arriba y le SUMA lo que haya aqui, no la sustituye, asi que
							     repetir una opcion de <options> solo consigue que el enlazado de
							     los tests la reciba dos veces. Aqui va unicamente lo que sea
							     exclusivo de los tests. -->
							<testOptions>
							</testOptions>
							<libs>
							</libs>					
						</linker>
						
						<tests>
							<test>
								<name>Test</name>
								<link>shared</link>
								<args>
									<arg>${test}</arg>
								</args>
							</test>
						</tests>						
					</configuration>
					<executions>
						<execution >
							<id>default-nar-vcproj</id>
							<configuration>
								<skip>true</skip>
							</configuration>
						</execution>					
						<execution>
							<id>default-nar-javah</id>
							<configuration>
								<skip>true</skip>
							</configuration>
						</execution>					
					</executions>					
				</plugin>
			</plugins>
		</pluginManagement>				

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-resources-plugin</artifactId>
				<configuration>
					<skip>${skip.if.not.source}</skip>
					<includeEmptyDirs>true</includeEmptyDirs>
				</configuration>
				<executions>
					<execution>
						<id>copy-resources</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${gjs.nar.build.directory}</outputDirectory>
							<changeDetection>always</changeDetection>
							<resources>
								<resource>
									<directory>${resources.dir}</directory>
									<includes>
										<include>**/**</include>
									</includes>
									<excludes>
										<exclude>bin/**</exclude>
										<exclude>data/**</exclude>
										<exclude>cacerts/**</exclude>
									</excludes>
									<filtering>true</filtering>
								</resource>
								<resource>
									<directory>${resources.dir}</directory>
									<includes>
										<include>bin/**</include>
										<include>data/**</include>
										<include>cacerts/**</include>
									</includes>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>						
				   <execution>
						<id>copy-test-resources</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>copy-resources</goal>
						</goals>
						<configuration>
							<outputDirectory>${gjs.nar.build.testDirectory}</outputDirectory>
							<changeDetection>always</changeDetection>
							<resources>
								<resource>
									<directory>${testResources.dir}</directory>
									<includes>
										<include>**/**</include>
									</includes>
									<excludes>
										<exclude>bin/**</exclude>
										<exclude>data/**</exclude>
										<exclude>cacerts/**</exclude>
									</excludes>
									<filtering>true</filtering>
								</resource>
								<resource>
									<directory>${testResources.dir}</directory>
									<includes>
										<include>bin/**</include>
										<include>data/**</include>
										<include>cacerts/**</include>
									</includes>
									<filtering>false</filtering>
								</resource>
							</resources>
						</configuration>
					</execution>						
				</executions>
			</plugin>	
			<!-- gjs-no-java-parent desactiva default-jar ( phase none ) para Python y
			     npm, pero el ciclo de vida nar lo necesita: enlaza maven-jar-plugin:jar
			     en package, y ese jar es el artefacto principal del modulo, el que
			     lleva META-INF/nar/.../nar.properties con el que los consumidores
			     resuelven los NAR adjuntos. Se reactiva aqui. skipIfEmpty porque una
			     ejecucion con phase tambien corre en los parents ( packaging pom ),
			     que no tienen target/classes: sin el, adjuntarian un jar vacio. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<executions>
					<execution>
						<id>default-jar</id>
						<phase>package</phase>
						<configuration>
							<skipIfEmpty>true</skipIfEmpty>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
		
		<directory>${basedir}/target</directory>
	</build>

	<profiles>
		<profile>
			<id>debug</id>
            <properties>
                <gjs.nar.optimization>none</gjs.nar.optimization>
            </properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.gjsoft.maven.plugins</groupId>
						<artifactId>nar-maven-plugin</artifactId>
						<configuration>
							<!-- Un <option> es UN argumento: el plugin hace arg.setValue(cadena)
							     sin partir por espacios, y ademas CommandLineCompiler entrecomilla
							     en Windows cualquier argumento que contenga uno. Los dos flags iban
							     juntos en una sola cadena (via gjs.compiler.additionalOptions) y
							     le habrian llegado a gcc como un unico argumento entrecomillado.
							     Por eso van uno por <option>, y por append, que es el mismo idioma
							     que usa el perfil cobertura.

							     El -g no se pone a mano: lo emite el compilador a partir del
							     <debug>true</debug> de aqui abajo. Hubo que ponerlo suelto durante
							     un tiempo porque ese <debug> no llegaba a aplicarse, justamente por
							     el append mal puesto que se explica al final de este comentario.
							     -ftrivial-auto-var-init=pattern: rellena toda variable automatica
							     sin inicializar; los punteros quedan en 0xFEFEFEFEFEFEFEFE, fuera
							     del rango que acepta ES_VALIDO ( ver Memoria.h ). Es el sustituto
							     GNU de los rellenos 0xCC / 0xCD del CRT de depuracion de MSVC.
							     Comprobado con gcc 14.4 de Cygwin y de MinGW.
							     La alternativa '=zero' deja los punteros a nulo: mas barata, y la
							     detecta igual cualquier ES_VALIDO.

							     El append va en <options> y NO en <c>/<cpp>: appendear el elemento
							     entero anadia un segundo <debug> junto al <debug>false</debug> del
							     pluginManagement en vez de sustituirlo. -->
							<c>
								<debug>true</debug>
								<options combine.children="append">
									<option>-ftrivial-auto-var-init=pattern</option>
								</options>
							</c>
							<cpp>
								<debug>true</debug>
								<options combine.children="append">
									<option>-ftrivial-auto-var-init=pattern</option>
								</options>
							</cpp>
						</configuration>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>runtime-win</id>
			<activation>
                <property>
					<name>environment.style</name>
					<value>windows</value>
				</property>
			</activation>
            <properties>		
				<gjs.nar.threads.option>-mthreads</gjs.nar.threads.option>
            </properties>
		</profile>
		<profile>
			<id>cobertura</id>
			<!-- TODO compilar en un subdirectorio diferente -->
			<build>
				<plugins>
					<plugin>
						<groupId>org.gjsoft.maven.plugins</groupId>
						<artifactId>nar-maven-plugin</artifactId>
						<configuration>
							<!-- El flag de cobertura de gcc tiene que llegar a TRES sitios, y
							     faltaban dos:
							     1) <c>: el stack C de gjs compila por ahi
							        (gjs.source.language=c), asi que estando solo en <cpp> no se
							        instrumentaba absolutamente nada.
							     2) <linker>: al compilar genera los .gcno e instrumenta el codigo,
							        pero es al enlazar cuando arrastra libgcov, y sin ella el
							        Test.exe no resuelve los simbolos gcov.
							     Va en <options> y no en <testOptions> porque estos se SUMAN a
							     aquellos (Compiler.getTestCompiler y Linker.getTestLinker parten
							     de la configuracion normal y le anaden los suyos), asi que una
							     sola vez cubre tambien la compilacion y el enlazado de los tests.
							     El flag equivale a fprofile-arcs y ftest-coverage al compilar mas
							     lgcov al enlazar; por eso no hacen falta sueltos. -->
							<c>
								<options combine.children="append">
									<option>--coverage</option>
								</options>
							</c>
							<cpp>
								<options combine.children="append">
									<option>--coverage</option>
								</options>
							</cpp>
							<linker>
								<!-- Aqui NO vale el mismo flag que en la compilacion, aunque hagan
								     lo mismo: GccLinker.decorateLinkerOption deja pasar al driver
								     las opciones cuyo segundo caracter es g f F m O W l L u v, y
								     envuelve el resto en -Wl, para ld. El flag de cobertura empieza
								     por dos guiones, cae en el 'resto', y ld lo rechaza con
								     "unrecognized option". fprofile-arcs empieza por -f, pasa
								     entero, y al enlazar hace que el driver anada -lgcov el solo, y
								     en el sitio correcto: escribir -lgcov aqui a mano lo colocaria
								     ANTES de los objetos, que con una libreria estatica no resuelve
								     nada. -->
								<options combine.children="append">
									<option>-fprofile-arcs</option>
								</options>
							</linker>
						</configuration>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<id>cobertura</id>
								<!-- Corre despues de nar-test, aunque compartan fase: dentro de una
								     misma fase Maven ejecuta primero las ejecuciones que vienen del
								     ciclo de vida del packaging (las default-*, y nar-test es una de
								     ellas) y despues las declaradas en el pom, sea cual sea el orden
								     en que se declaren los plugins. Comprobado. Sin los .gcda que
								     dejan los tests al correr, gcovr solo veria los .gcno y daria
								     cobertura cero. -->
								<phase>test</phase>
								<configuration>
									<target name="execute-gcovr">
										<!-- Al estilo POSIX todas las rutas que va a ver el Python de Cygwin,
										     la del propio script incluida. cygpath -u es idempotente: si la
										     ruta ya viene en estilo POSIX, la deja igual. -->
										<exec executable="${cpp.cygpath}" outputproperty="cpp.gcovr.script.posix" failonerror="true">
											<arg value="-u"/>
											<arg value="${cpp.gcovr}"/>
										</exec>
										<exec executable="${cpp.cygpath}" outputproperty="cpp.gcovr.root.posix" failonerror="true">
											<arg value="-u"/>
											<arg value="${cpp.gcovr.root}"/>
										</exec>
										<exec executable="${cpp.cygpath}" outputproperty="cpp.gcovr.target.posix" failonerror="true">
											<arg value="-u"/>
											<arg value="${cpp.gcovr.target}"/>
										</exec>
										<mkdir dir="${cpp.gcovr.target}"/>
										<exec executable="${cpp.gcovr.python}" dir="${cpp.gcovr.dir}" failonerror="true">
											<arg value="${cpp.gcovr.script.posix}"/>
											<arg value="-r"/>
											<arg value="${cpp.gcovr.root.posix}"/>
											<arg value="--html-details"/>
											<arg value="-o${cpp.gcovr.target.posix}/index.html"/>
										</exec>
									</target>
								</configuration>
								<goals>
									<goal>run</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>eclipse</id>
			<activation>
				<property>
					<name>m2e.version</name>
				</property>
			</activation>
			<build>
				<pluginManagement>
					<plugins>
						<!-- This plugin's configuration is used to store Eclipse m2e settings
						 only. It has no influence on the Maven build itself. -->
						<plugin>
							<groupId>org.eclipse.m2e</groupId>
							<artifactId>lifecycle-mapping</artifactId>
