<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.gjs</groupId>
		<artifactId>gjs-no-java-parent</artifactId>
		<version>1.0.0-RC.2</version>
		<relativePath>../../../gjs-no-java-parent</relativePath>
	</parent>	

    <groupId>org.gjs.c</groupId>
    <artifactId>gjs-c-common-parent</artifactId>
	<packaging>pom</packaging>

	<name>GJS common C/C++ parent</name>
	<description>
		Maven C/C++ general parent pom.
		.
		.	Pom organization:
		.
		.	gjs-parent
		.	   └── gjs-no-java-parent
		.				└── gjs-c-common-parent
		.						   └── gjs-c-nar-extension-parent
		.									└── gjs-c-nar-parent
		.											   ├── gjs-c-parent
		.											   │          ├── gjs-c-lib-parent
		.											   │          ├── gjs-c-stlib-parent
		.											   │          └── gjs-c-exe-parent
		.											   └── gjs-cpp-parent
		.														  ├── gjs-cpp-lib-parent
		.														  ├── gjs-cpp-stlib-parent
		.													  	  └── gjs-cpp-exe-parent
		.
		Needs profile cpp with special properties in settings.xml file: 
		
			* cygwinDir : Directory of Cygwin installation (from gjs-parent)

			* systemUser : Username for Cygwin, or Linux/Unix system
						
			* oracleDir : Directory of Oracle installation
			
			* visualStudioVCDir : Directory of VC header and lib files (if is present)
		.
		To compile on pure Windows (without Cygwin) the gcc and g++ compiler executables need to be accessible
		in the PATH. 
	</description>

	<properties>
		<!-- Default programming language features -->
		<gjs.source.language>c</gjs.source.language>
		<gjs.source.extension>c</gjs.source.extension>

		<!-- Binary prefixes -->
		<exeFinalPrefix></exeFinalPrefix>
		<libFinalPrefix>lib</libFinalPrefix>
		
		<!-- Windows parameters -->
		<!-- SDK -->
		<windows.dir.sdk>C:\Program Files (x86)\Windows Kits\${windows.sdk.version}</windows.dir.sdk>		

		<!-- External installed libs -->
		<windows.dir.lib.custom>C:\CustomLibs</windows.dir.lib.custom>		
		
		<!-- System Libraries directories -->
		<windows.dir.lib>${windows.dir.sdk}\Lib\10.0.26100.0</windows.dir.lib>		
		<windows.dir.include>${windows.dir.sdk}\Include\10.0.26100.0</windows.dir.include>		
		<windows-crt.dir.lib.runtime>${windows.dir.lib}\ucrt\${windows.sdk.architecture}</windows-crt.dir.lib.runtime>		
		<windows-crt.dir.lib.system>${windows.dir.lib}\um\${windows.sdk.architecture}</windows-crt.dir.lib.system>		
		<windows-crt.dir.lib.installed></windows-crt.dir.lib.installed>		
		<windows-crt.dir.include.additional>${windows.dir.include}\shared</windows-crt.dir.include.additional>		
		<windows-crt.dir.include.runtime>${windows.dir.include}\ucrt</windows-crt.dir.include.runtime>		
		<windows-crt.dir.include.system>${windows.dir.include}\um</windows-crt.dir.include.system>		
		<windows-winrt.dir.lib.runtime>${windows.dir.lib}\ucrt\${windows.sdk.architecture}</windows-winrt.dir.lib.runtime>		
		<windows-winrt.dir.lib.system>${windows.dir.lib}\um\${windows.sdk.architecture}</windows-winrt.dir.lib.system>		
		<windows-crt.dir.lib.installed></windows-crt.dir.lib.installed>		
		<windows-winrt.dir.include.additional>${windows.dir.include}\shared</windows-winrt.dir.include.additional>		
		<windows-winrt.dir.include.runtime>${windows.dir.include}\ucrt</windows-winrt.dir.include.runtime>		
		<windows-winrt.dir.include.runtime>${windows.dir.include}\winrt</windows-winrt.dir.include.runtime>		
		<windows-winrt.dir.include.system>${windows.dir.include}\um</windows-winrt.dir.include.system>		
		<windows-cppwinrt.dir.lib.runtime>${windows.dir.lib}\ucrt\${windows.sdk.architecture}</windows-cppwinrt.dir.lib.runtime>		
		<windows-cppwinrt.dir.lib.system>${windows.dir.lib}\um\${windows.sdk.architecture}</windows-cppwinrt.dir.lib.system>		
		<windows-cppwinrt.dir.include.additional>${windows.dir.include}\shared</windows-cppwinrt.dir.include.additional>		
		<windows-cppwinrt.dir.include.runtime>${windows.dir.include}\ucrt</windows-cppwinrt.dir.include.runtime>		
		<windows-cppwinrt.dir.include.cpp.runtime>${windows.dir.include}\cppwinrt</windows-cppwinrt.dir.include.cpp.runtime>		
		<windows-cppwinrt.dir.lib.system>${windows.dir.lib}\um\${windows.sdk.architecture}</windows-cppwinrt.dir.lib.system>		

		<!-- Cygwin parameters -->
		<!-- User home -->
		<cygwin.home>${cygwinDir}/home/${systemUser}</cygwin.home>		

		<!-- External installed libs -->
		<cygwin.dir.lib.custom>${cygwin.home}/lib</cygwin.dir.lib.custom>		
		
		<!-- System Libraries directories -->
		<cygwin-posix.dir.lib.runtime></cygwin-posix.dir.lib.runtime>
		<cygwin-posix.dir.lib.system>${cygwinDir}/usr/x86_64-w64-mingw32/sys-root/mingw/bin</cygwin-posix.dir.lib.system>		
		<cygwin-posix.dir.lib.system.additional>${cygwinDir}/lib</cygwin-posix.dir.lib.system.additional>		
		<cygwin-posix.dir.lib.installed>${cygwinDir}/usr/local/share</cygwin-posix.dir.lib.installed>
		<cygwin-posix.dir.include.system>${cygwinDir}/usr/include</cygwin-posix.dir.include.system>
		<cygwin-posix.dir.include.installed>${cygwinDir}/usr/local/include</cygwin-posix.dir.include.installed>
		<cygwin-posix.dir.include.additional></cygwin-posix.dir.include.additional>
		<cygwin-windows.dir.lib.runtime></cygwin-windows.dir.lib.runtime>
		<cygwin-windows.dir.lib.system>${cygwinDir}/usr/x86_64-w64-mingw32/sys-root/mingw/bin</cygwin-windows.dir.lib.system>		
		<cygwin-windows.dir.lib.system.additional>${cygwinDir}/lib</cygwin-windows.dir.lib.system.additional>		
		<cygwin-windows.dir.lib.installed>${cygwinDir}/usr/local/share</cygwin-windows.dir.lib.installed>
		<cygwin-windows.dir.include.system>${cygwinDir}/usr/include</cygwin-windows.dir.include.system>
		<cygwin-windows.dir.include.installed>${cygwinDir}/usr/local/include</cygwin-windows.dir.include.installed>
		<cygwin-windows.dir.include.additional></cygwin-windows.dir.include.additional>
		<!--
		<cygwin-windows.dir.lib.runtime>${windows-crt.dir.lib.runtime}</cygwin-windows.dir.lib.runtime>
		<cygwin-windows.dir.lib.system>${windows-crt.dir.lib.system}</cygwin-windows.dir.lib.system>		
		<cygwin-windows.dir.lib.system.additional></cygwin-windows.dir.lib.system.additional>
		<cygwin-windows.dir.lib.installed>${cygwinDir}/usr/local/lib</cygwin-windows.dir.lib.installed>
		<cygwin-windows.dir.include.system>${windows-crt.dir.include.system}</cygwin-windows.dir.include.system>
		<cygwin-windows.dir.include.installed>${cygwinDir}/usr/local/include</cygwin-windows.dir.include.installed>
		<cygwin-windows.dir.include.additional>${windows-crt.dir.include.additional}</cygwin-windows.dir.include.additional>
		-->
		<!-- Unix / Linux parameters -->
		<!-- User home -->
		<unix.home>/home/${systemUser}</unix.home>		

		<!-- External installed libs -->
		<unix.dir.lib.custom>${unix.home}/lib</unix.dir.lib.custom>		
		
		<!-- System Libraries directories -->
		<unix.dir.lib.runtime></unix.dir.lib.runtime>		
		<unix.dir.lib.system>${cygwinDir}/lib</unix.dir.lib.system>		
		<unix.dir.lib.system.additional></unix.dir.lib.system.additional>
		<unix.dir.lib.installed>${cygwinDir}/usr/local/lib</unix.dir.lib.installed>
		<unix.dir.include.system>${cygwinDir}/usr/include</unix.dir.include.system>
		<unix.dir.include.installed>${cygwinDir}/usr/local/include</unix.dir.include.installed>
		<unix.dir.include.additional></unix.dir.include.additional>
		
		<!-- CppCheck Tool directory -->
		<cpp.checkDir>${cygwinDir}${unix.home}/bin</cpp.checkDir>
		
		<!-- Apache Log4cxx directory -->
		<log4cxxDir>${cygwin.dir.lib.custom}/log4cxx</log4cxxDir>
		<log4cxxDirInclude>${log4cxxDir}/include</log4cxxDirInclude>
		<log4cxxDirLib>${log4cxxDir}/lib</log4cxxDirLib>
	
		<!-- GLib  directory -->
		<glibDir>${cygwinDir}/lib/glib-2.0</glibDir>
		<glibDirInclude>${glibDir}/include</glibDirInclude>
		
		<!-- Open Xml parser directory -->
		<xmlDir>${cygwinDir}/usr/x86_64-w64-mingw32/sys-root/mingw/lib/cmake/libxml2</xmlDir>
		<xmlDirInclude>${xmlDir}/include</xmlDirInclude>
		
		<!-- Open SSL directory -->
		<sslDir>${cygwinDir}/lib/openssl-1.0</sslDir>
		<sslDirInclude>${sslDir}/include</sslDirInclude>

		<!-- Oracle client directory -->
		<oraClientDir>${oraDir}/instantclient_19_12</oraClientDir>
		<oraDirInclude>${oraDir}/sdk/include</oraDirInclude>
		
		<!-- Checkstyle -->
		<cpp.check>${cpp.checkDir}/cppcheck</cpp.check>
		<!-- Informe HTML navegable: una pagina por fichero con el fuente anotado.
		     El script es autocontenido, solo necesita la libreria Pygments. -->
		<cpp.check.report>${cpp.checkDir}/cppcheck-htmlreport</cpp.check.report>
		<cpp.check.report.dir>${project.build.directory}/check-report</cpp.check.report.dir>
		<!-- OJO: el interprete debe entender rutas Windows. El XML de cppcheck lleva
		     rutas absolutas tipo C:/... (vienen de los -I) y el Python de Cygwin no las
		     reconoce como absolutas: las concatena a la ruta de source-dir y deja esos
		     ficheros fuera del informe, sin dar error. Bajo Cygwin hay que apuntar a un
		     Python de Windows. -->
		<cpp.check.python>python</cpp.check.python>
		<cpp.check.execute>false</cpp.check.execute>
		<cpp.check.severity>all</cpp.check.severity>	
		<cpp.check.configurations>1</cpp.check.configurations>

	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Apache Maven plugins -->

				<!--
				<plugin>
					<groupId>org.sonatype.plugins</groupId>
					<artifactId>nexus-staging-maven-plugin</artifactId>
					<version>1.6.13</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>wagon-maven-plugin</artifactId>
					<version>2.0.2</version>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>wagon-ssh-external</artifactId>
					<version>3.5.2</version>
				</plugin>
				-->
			</plugins>
		</pluginManagement>		

		<extensions>
			<extension>
				<groupId>org.gjs.maven.extensions</groupId>
				<artifactId>property-bootstrap-maven-extension</artifactId>
				<version>1.0.0-RC.2</version>
			</extension>
			<!--
			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-ftp</artifactId>
			</extension>
			<extension>
				<groupId>org.apache.maven.wagon</groupId>
				<artifactId>wagon-ssh</artifactId>
			</extension>
			-->
		</extensions>

		<plugins>
			<!-- TODO: Provisional hasta ver el efecto del despliegue de ficheros NAR -->
			<plugin>
			   <groupId>org.apache.maven.plugins</groupId>
			   <artifactId>maven-deploy-plugin</artifactId>
			   <configuration>
				  <skip>true</skip>
			   </configuration>
			</plugin>		
			<plugin>
				<groupId>org.codehaus.gmavenplus</groupId>
				<artifactId>gmavenplus-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-compile</id>
						<phase>initialize</phase>
						<goals>
							<goal>execute</goal>
						</goals>
						<configuration>
							<scripts>
								<script><![CDATA[
									if ( ! "true".equals( project.properties.get("skip.if.not.source") ) ) { 
									// 1. Obtener la variable 'environment' del build (ej: "dev")
									def env = project.properties['environment']
									
									// 2. Resolver dinámicamente el valor de las propiedades anidadas
									def dirRuntime   = project.properties["${env}.dir.lib.runtime"]
									def dirSystem    = project.properties["${env}.dir.lib.system"]
									def dirSystemAdd    = project.properties["${env}.dir.lib.system.additional"]
									def dirInst    = project.properties["${env}.dir.lib.installed"]
									def includeSys   = project.properties["${env}.dir.include.system"]
									def includeInst   = project.properties["${env}.dir.include.installed"]
									def includeAdd   = project.properties["${env}.dir.include.additional"]
									
									// 3. Crear el directorio destino (Equivalente al <mkdir>)
									def customDir = new File(project.build.directory, "custom")
									if (!customDir.exists()) customDir.mkdirs()
									
									// 4. Se definen las propiedades generales independientes del entorno
									project.properties["cpp.dir.lib.runtime"] = dirRuntime ?: ""
									project.properties["cpp.dir.lib.system"] = dirSystem ?: ""
									project.properties["cpp.dir.lib.system.additional"] = dirSystemAdd ?: ""
									project.properties["cpp.dir.lib.installed"] = dirInst ?: ""
									project.properties["cpp.dir.include.system"] = includeSys ?: ""
									project.properties["cpp.dir.include.installed"] = includeInst ?: ""
									project.properties["cpp.dir.include.additional"] = includeAdd ?: ""

									// 4.b Opciones -I ya montadas y filtradas. Un directorio vacio NO puede generar
									//     un "-I" suelto: cppcheck aborta con "argument to '-I' is missing".
									def includeOptions = [includeSys, includeInst, includeAdd]
										.findAll { it }
										.collect { "-I" + it }
										.join(" ")
									project.properties["cpp.dir.include.options"] = includeOptions

									// 5. Usar el AntBuilder nativo de GMaven para escribir el archivo de propiedades
									ant.propertyfile(file: "${customDir.absolutePath}/compile-context.properties") {
										entry(key: "cpp.dir.lib.runtime", value: dirRuntime ?: "")
										entry(key: "cpp.dir.lib.system", value: dirSystem ?: "")
										entry(key: "cpp.dir.lib.system.additional", value: dirSystemAdd ?: "")
										entry(key: "cpp.dir.lib.installed", value: dirInst ?: "")
										entry(key: "cpp.dir.include.system", value: includeSys ?: "")
										entry(key: "cpp.dir.include.installed", value: includeInst ?: "")
										entry(key: "cpp.dir.include.additional", value: includeAdd ?: "")
										entry(key: "cpp.dir.include.options", value: includeOptions)
									}
									
									log.info "Contexto de C/C++ generado exitosamente en Groovy para el entorno: ${env}"
									} else {
										log.info ( "Skipping the execution.\n" )
									}
								]]></script>
							</scripts>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<configuration>
					<skip>${skip.if.not.source}</skip>
				</configuration>
				<executions>
					<execution>
						<id>prepare-tests</id>
						<phase>generate-test-sources</phase>
						<configuration>
							<target name="prepare-context-for-tests">
								<mkdir dir="${project.basedir}/target/test-nar/results"/>
								<mkdir dir="${project.basedir}/target/test-nar/internal"/>
								<propertyfile file="${project.basedir}/target/test-nar/internal/test.properties">
									<entry key="project.basedir" value="${project.basedir}"/>
									<entry key="project.build.directory" value="${project.build.directory}"/>
									<entry key="project.build.testDirectory" value="${dirTest}"/>
								</propertyfile>
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
					
					<execution>
						<id>check</id>
						<!-- NO usar 'validate': el contexto C/C++ (cpp.dir.include.*) lo genera el script
						     Groovy de gmavenplus en 'initialize', que va despues. Vale cualquier fase
						     posterior a 'initialize'; se elige una explicita para no depender del orden
						     de declaracion de los plugins dentro de una misma fase. -->
						<phase>process-sources</phase>
						<configuration>
							<target name="execute-cppcheck" if="${cpp.check.execute}">
								<!-- El contexto se lee del fichero, no de las propiedades que gmavenplus inyecta
								     en el modelo de Maven: asi la dependencia es explicita y el check se puede
								     relanzar suelto (mvn antrun:run@check) tras un build. -->
								<available file="${project.build.directory}/custom/compile-context.properties" property="cpp.check.context.available"/>
								<fail unless="cpp.check.context.available" message="Falta ${project.build.directory}/custom/compile-context.properties: el script Groovy de gmavenplus (fase initialize) no se ha ejecutado."/>
								<property file="${project.build.directory}/custom/compile-context.properties"/>
								<mkdir dir="${project.basedir}/target/check"/>
								<!-- El informe NO puede ir a target/check: ahi vive la cache .a1 de
								     cppcheck-build-dir, que no es un informe sino datos de analisis. -->
								<mkdir dir="${cpp.check.report.dir}"/>
								<!-- Macros predefinidos del compilador. cppcheck no los conoce, y sin ellos el
								     preprocesado se va al traste: las cabeceras de Cygwin deciden el tipo de
								     intptr_t con __INTPTR_TYPE__ y sin el disparan un #error que ABORTA el
								     analisis del fichero (de ahi los "0 avisos" enganosos). El compilador y el
								     lenguaje salen de las mismas propiedades que usa la compilacion real, asi
								     que esto se ajusta solo a C/C++ y al modo (gcc de Cygwin o de MinGW).
								     El fichero vacio hace de /dev/null, que no existe en Windows puro. -->
								<touch file="${project.basedir}/target/check/empty.c"/>
								<exec executable="${gjs.nar.compiler}" output="${project.basedir}/target/check/compiler-defines.h" failonerror="false">
									<arg value="-dM"/>
									<arg value="-E"/>
									<arg value="-x"/>
									<arg value="${gjs.nar.compiler.language}"/>
									<arg value="${project.basedir}/target/check/empty.c"/>
								</exec>
								<exec executable="${cpp.check}" dir="${project.basedir}/src/main/${gjs.source.language}" failonerror="false">
									<arg value="--language=${gjs.nar.compiler.language}"/>
									<arg value="--include=${project.basedir}/target/check/compiler-defines.h"/>
									<!-- Los mismos -D de plataforma que recibe el compilador (CYGWIN_POSIX /
									     CYGWIN_WIN), para que se analicen las ramas WIN/POSIX que se compilan
									     de verdad. Por defecto esta vacio, y vacio no anade ningun argumento. -->
									<arg line="${gjs.nar.platform.options}"/>
									<!-- TODO: Asegurar que cppcheck es la última version -->
									<arg value="--std=${gjs.nar.language.standard}"/>
									<arg value="--platform=native"/>
									<arg value="--enable=${cpp.check.severity}"/>
									<arg value="--max-configs=${cpp.check.configurations}"/>
									<arg value="-I${project.basedir}/src/main/include"/>
									<arg value="-I${glibDirInclude}"/>
									<arg value="-I${sslDirInclude}"/>
									<arg value="-I${oraDirInclude}"/>
									<arg value="-I${xmlDirInclude}"/>
									<arg value="-I${log4cxxDirInclude}"/>											
									<!-- Las -I del contexto van en una sola cadena ya filtrada por el script Groovy:
									     un directorio vacio generaria un "-I" suelto y cppcheck aborta con
									     "argument to '-I' is missing". arg line reparte por espacios (ninguna de
									     estas rutas los tiene) y con la cadena vacia no anade ningun argumento. -->
									<arg line="${cpp.dir.include.options}"/>
									<arg value="--suppress=virtualCallInConstructor"/>
									<arg value="--suppress=uninitMemberVar"/>		
									<arg value="--suppress=useInitializationList"/>		
									<arg value="--suppress=toomanyconfigs"/>
									<!-- Las cabeceras estandar que falten se quedan en un aviso informativo:
									     cppcheck se apoya en sus ficheros .cfg, no en los headers reales. No
									     hay que darle los del propio compilador (el include de gcc ni los de
									     libstdc++): rompen el analisis por include_next y __has_builtin. -->
									<arg value="--suppress=missingIncludeSystem"/>
									<!-- OJO: suppress usa el formato id:fichero:linea, y parte por ':'. Una
									     ruta Windows con letra de unidad (C:/...) rompe el parseo y aborta
									     cppcheck, asi que los patrones van sin unidad: *:*/ruta/* -->
									<arg value="--suppress=*:*/instantclient_*/sdk/include/*"/>
									<arg value="--cppcheck-build-dir=${project.basedir}/target/check"/>
									<!-- Con la opcion xml TODOS los avisos van al fichero: ya no salen por
									     consola. La via de consulta pasa a ser el informe HTML de mas abajo. -->
									<arg value="--xml"/>
									<arg value="--output-file=${cpp.check.report.dir}/cppcheck.xml"/>
									<!-- arg value="++check-config" /-->
									<arg value="." />
								</exec>
								<!-- Informe navegable a partir del XML: index.html con los avisos agrupados
								     por fichero, una pagina por fichero con el fuente resaltado y la linea
								     marcada, y stats.html con el desglose por severidad. -->
								<exec executable="${cpp.check.python}" failonerror="false">
									<arg value="${cpp.check.report}"/>
									<arg value="--file=${cpp.check.report.dir}/cppcheck.xml"/>
									<arg value="--report-dir=${cpp.check.report.dir}/html"/>
									<arg value="--source-dir=${project.basedir}/src/main/${gjs.source.language}"/>
									<arg value="--title=${project.artifactId}"/>
								</exec>
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>cpp</id>
			<activation>
				<!-- Activo siempre -->
				<file>
					<exists>${basedir}/pom.xml</exists>
				</file>
			</activation>
		</profile>
		<profile>
			<id>cygwin-posix</id>
			<activation>
				<property>
					<name>cygwin.style</name>
					<value>!windows</value>
				</property>
			</activation>
			<properties>
				<platformOptions>-DCYGWIN_POSIX</platformOptions>
			</properties>
		</profile>
		<profile>
			<id>cygwin-win</id>
			<activation>
				<property>
					<name>cygwin.style</name>
					<value>windows</value>
				</property>
			</activation>
			<properties>
				<platformOptions>-DCYGWIN_WIN</platformOptions>
			</properties>
		</profile>
		<profile>
			<id>cppcheck</id>
			<properties>
				<cpp.check.execute>true</cpp.check.execute>
			</properties>
		</profile>
	</profiles>
</project>