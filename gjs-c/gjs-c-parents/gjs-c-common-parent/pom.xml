<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.gjsoft</groupId>
		<artifactId>gjs-no-java-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../../../gjs-no-java-parent</relativePath>
	</parent>	

    <groupId>org.gjsoft.c</groupId>
    <artifactId>gjs-c-common-parent</artifactId>
	<packaging>pom</packaging>

	<name>GJS common C/C++ parent</name>
	<description>
		Maven C/C++ general parent pom.
		.
		.	Pom organization:
		.
		.	gjs-parent
		.	   └── gjs-no-java-parent
		.				└── gjs-c-common-parent
		.						   └── gjs-c-nar-extension-parent
		.									└── gjs-c-nar-parent
		.											   ├── gjs-c-parent
		.											   │          ├── gjs-c-lib-parent
		.											   │          ├── gjs-c-stlib-parent
		.											   │          └── gjs-c-exe-parent
		.											   └── gjs-cpp-parent
		.														  ├── gjs-cpp-lib-parent
		.														  ├── gjs-cpp-stlib-parent
		.													  	  └── gjs-cpp-exe-parent
		.
		Needs profile cpp with special properties in settings.xml file: 
		
			* cygwinDir : Directory of Cygwin installation (from gjs-parent)

			* systemUser : Username for Cygwin, or Linux/Unix system
						
			* oraDir : Directory of Oracle client installation
		.
		To compile on pure Windows (without Cygwin) the gcc and g++ compiler executables need to be accessible
		in the PATH. 
	</description>

	<properties>
		<!-- Default programming language features -->
		<gjs.source.language>c</gjs.source.language>
		<gjs.source.extension>c</gjs.source.extension>

		<!-- Binary prefixes -->
		<exeFinalPrefix></exeFinalPrefix>
		<libFinalPrefix>lib</libFinalPrefix>
		
		<!-- Cygwin parameters -->
		<!-- User home -->
		<cygwin.home>${cygwinDir}/home/${systemUser}</cygwin.home>		

		<!-- External installed libs -->
		<cygwin.dir.lib.custom>${cygwin.home}/lib</cygwin.dir.lib.custom>		
		
		<!-- System Libraries directories -->
		<!-- .dir.lib.system  : donde estan las librerias de importacion ( .a ), para el -L.
		     .dir.lib.runtime : donde estan las DLL que el binario necesita AL EJECUTARSE.
		     Sale por <binDirectory> de cada <lib> y el nar lo mete en el PATH de los
		     tests. Sin el, un Test.exe de MinGW muere con 0xC0000135 buscando
		     libwinpthread-1.dll. NO es el antiguo "sabor de CRT" de Visual C++. -->
		<cygwin.dir.lib.system>${cygwinDir}/lib</cygwin.dir.lib.system>		
		<cygwin.dir.lib.runtime>${cygwinDir}/bin</cygwin.dir.lib.runtime>

		<!-- Windows parameters -->
		<windows.dir.lib.system>${cygwinDir}/usr/x86_64-w64-mingw32/sys-root/mingw/lib</windows.dir.lib.system>		
		<windows.dir.lib.runtime>${cygwinDir}/usr/x86_64-w64-mingw32/sys-root/mingw/bin</windows.dir.lib.runtime>

		<!-- Unix / Linux parameters -->
		<!-- User home -->
		<unix.home>/home/${systemUser}</unix.home>		

		<!-- External installed libs -->
		<unix.dir.lib.custom>${unix.home}/lib</unix.dir.lib.custom>		
		
		<!-- System Libraries directories -->
		<unix.dir.lib.system>${cygwinDir}/lib</unix.dir.lib.system>		
		<unix.dir.lib.runtime>/usr/lib</unix.dir.lib.runtime>
		
		<!-- GLib  directory -->
		<glibDir>${cygwinDir}/lib/glib-2.0</glibDir>
		<glibDirInclude>${glibDir}/include</glibDirInclude>
		
		<!-- Open Xml parser directory -->
		<xmlDir>${cygwinDir}/usr/x86_64-w64-mingw32/sys-root/mingw/lib/cmake/libxml2</xmlDir>
		<xmlDirInclude>${xmlDir}/include</xmlDirInclude>
		
		<!-- Open SSL directory -->
		<sslDir>${cygwinDir}/lib/openssl-1.0</sslDir>
		<sslDirInclude>${sslDir}/include</sslDirInclude>

		<!-- Oracle client directory -->
		<oraDirInclude>${oraDir}/sdk/include</oraDirInclude>
		
		<!-- Checkstyle: CppCheck Tool directory -->
		<cpp.checkDir>${cygwinDir}${unix.home}/bin</cpp.checkDir>
		<cpp.check>${cpp.checkDir}/cppcheck</cpp.check>
		<cpp.platform.options>${platformOptions}</cpp.platform.options>

		<!-- Prefijo del juego de herramientas. Vacio = gcc/g++ del PATH. El perfil
		     win lo cambia al cruzado de MinGW: si no, en Windows nativo sale el gcc
		     de Cygwin, que con -DWIN compila Cygwin con macros de Windows. -->
		<gjs.nar.toolchain.prefix></gjs.nar.toolchain.prefix>

		<!-- Triplete del objetivo. Alimenta <architecture> del nar y con el el AOL,
		     que es el clasificador del artefacto: si no cambia por plataforma, el nar
		     de Windows y el de Cygwin comparten nombre y se pisan. Lo fijan los
		     perfiles win / cygwin / unix; este valor solo actua si no hay ninguno. -->
		<gjs.nar.architecture>x86_64-pc-cygwin</gjs.nar.architecture>
		<!-- Emulacion del enlazador. i386pep es PE de 64 bits: la unica que admiten
		     el ld de Cygwin y el de MinGW ( binutils 2.46.1 ). Linux es ELF. -->
		<gjs.nar.emulation>i386pep</gjs.nar.emulation>
		<!-- To be defined in child pom -->
		<cpp.language.standard />
		<cpp.compiler />
		<cpp.compiler.language />

		<!-- Informe HTML navegable: una pagina por fichero con el fuente anotado.
		     El script es autocontenido, solo necesita la libreria Pygments. -->
		<cpp.check.report>${cpp.checkDir}/cppcheck-htmlreport</cpp.check.report>
		<cpp.check.report.dir>${project.build.directory}/check-report</cpp.check.report.dir>
		<!-- OJO: el interprete debe entender rutas Windows. El XML de cppcheck lleva
		     rutas absolutas tipo C:/... (vienen de los -I) y el Python de Cygwin no las
		     reconoce como absolutas: las concatena a la ruta de source-dir y deja esos
		     ficheros fuera del informe, sin dar error. Bajo Cygwin hay que apuntar a un
		     Python de Windows. -->
		<cpp.check.python>python</cpp.check.python>
		<cpp.check.execute>false</cpp.check.execute>
		<cpp.check.severity>all</cpp.check.severity>	
		<cpp.check.configurations>1</cpp.check.configurations>

		<!-- Doxygen: el equivalente al javadoc para C/C++. Solo lo usa el perfil
		     deploy-central. Viene con la instalacion de Cygwin, no es una herramienta
		     compilada a mano, asi que no vive en ${cpp.checkDir}. -->
		<cpp.doxygen>${cygwinDir}/bin/doxygen.exe</cpp.doxygen>
		<cpp.doxygen.dir>${project.build.directory}/doxygen</cpp.doxygen.dir>
		<!-- Presentacion. En NO, doxygen lee un "typedef struct {...} SConversor;"
		     como una clase de C++: lo lista bajo "Class List" y le genera su pagina
		     de miembros. En YES pasa a "Data Structures" y no la genera; el indice de
		     ficheros y los globals_* salen igual en los dos modos. Va en YES por
		     defecto, como gjs.source.language, y gjs-cpp-parent lo pone en NO. -->
		<cpp.doxygen.optimize.c>YES</cpp.doxygen.optimize.c>
		<!-- OJO: doxygen es un binario de Cygwin y, a diferencia de cppcheck, NO
		     reconoce C:/... como absoluto en OUTPUT_DIRECTORY ni en INPUT: lo trata
		     como relativo y lo cuelga del directorio de trabajo. Hay que convertir
		     esas rutas con cygpath -u, igual que se hace con gcovr. -->
		<cpp.cygpath>${cygwinDir}/bin/cygpath.exe</cpp.cygpath>
		<!-- No se firma lo que no se publica. Estos artefactos quedan fuera del bundle
		     de Central por el excludeArtifacts del perfil deploy-central en gjs-parent,
		     asi que firmarlos seria trabajo tirado: son 25 modulos y gpg tarda. Es el
		     hermano del <skip> del maven-deploy-plugin que hay mas abajo, y como aquel,
		     provisional: si algun dia estos artefactos se publican, quitar los dos. -->
		<gpg.skip>true</gpg.skip>
			
		<!-- Sonar -->
		<sonar.cfamily.compile-commands>${project.build.directory}/compile_commands.json</sonar.cfamily.compile-commands>
		<!-- Coding style: No permitimos que cuatro lumbreras decidan como codificar --> 
		<sonar.issue.ignore.multicriteria>c1,c2,c3,c4,c5,c6</sonar.issue.ignore.multicriteria>
		<sonar.issue.ignore.multicriteria.c1.ruleKey>c:S1103</sonar.issue.ignore.multicriteria.c1.ruleKey>
		<sonar.issue.ignore.multicriteria.c1.resourceKey>**/*</sonar.issue.ignore.multicriteria.c1.resourceKey>
		<sonar.issue.ignore.multicriteria.c2.ruleKey>cpp:S1103</sonar.issue.ignore.multicriteria.c2.ruleKey>
		<sonar.issue.ignore.multicriteria.c2.resourceKey>**/*</sonar.issue.ignore.multicriteria.c2.resourceKey>
		<sonar.issue.ignore.multicriteria.c3.ruleKey>c:S1110</sonar.issue.ignore.multicriteria.c3.ruleKey>
		<sonar.issue.ignore.multicriteria.c3.resourceKey>**/*</sonar.issue.ignore.multicriteria.c3.resourceKey>
		<sonar.issue.ignore.multicriteria.c4.ruleKey>cpp:S1110</sonar.issue.ignore.multicriteria.c4.ruleKey>
		<sonar.issue.ignore.multicriteria.c4.resourceKey>**/*</sonar.issue.ignore.multicriteria.c4.resourceKey>
		<sonar.issue.ignore.multicriteria.c5.ruleKey>c:S5955</sonar.issue.ignore.multicriteria.c5.ruleKey>
		<sonar.issue.ignore.multicriteria.c5.resourceKey>**/*</sonar.issue.ignore.multicriteria.c5.resourceKey>
		<sonar.issue.ignore.multicriteria.c6.ruleKey>cpp:S3230</sonar.issue.ignore.multicriteria.c6.ruleKey>
		<sonar.issue.ignore.multicriteria.c6.resourceKey>**/*</sonar.issue.ignore.multicriteria.c6.resourceKey>
	</properties>

	<build>
		<extensions>
			<extension>
				<groupId>org.gjsoft.maven.extensions</groupId>
				<artifactId>property-bootstrap-maven-extension</artifactId>
				<version>1.0.0</version>
			</extension>
		</extensions>

		<plugins>
			<!-- TODO: Provisional hasta ver el efecto del despliegue de ficheros NAR -->
			<plugin>
			   <groupId>org.apache.maven.plugins</groupId>
			   <artifactId>maven-deploy-plugin</artifactId>
			   <configuration>
				  <skip>true</skip>
			   </configuration>
			</plugin>		
			<plugin>
				<groupId>org.codehaus.gmavenplus</groupId>
				<artifactId>gmavenplus-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-compile</id>
						<phase>initialize</phase>
						<goals>
							<goal>execute</goal>
						</goals>
						<configuration>
							<scripts>
								<script><![CDATA[
									if ( ! "true".equals( project.properties.get("skip.if.not.source") ) ) { 
									// 1. Obtener la variable 'environment' del build (ej: "dev")
									def env = project.properties['environment']
									
									// 2. Resolver dinámicamente el valor de las propiedades anidadas
										def dirRuntime   = project.properties["${env}.dir.lib.runtime"]
									def dirSystem    = project.properties["${env}.dir.lib.system"]
									
									// 3. Crear el directorio destino (Equivalente al <mkdir>)
									def customDir = new File(project.build.directory, "custom")
									if (!customDir.exists()) customDir.mkdirs()
									
									// 4. Se definen las propiedades generales independientes del entorno
										project.properties["cpp.dir.lib.runtime"] = dirRuntime ?: ""
									project.properties["cpp.dir.lib.system"] = dirSystem ?: ""


									// 5. Usar el AntBuilder nativo de GMaven para escribir el archivo de propiedades
									ant.propertyfile(file: "${customDir.absolutePath}/compile-context.properties") {
											entry(key: "cpp.dir.lib.runtime", value: dirRuntime ?: "")
										entry(key: "cpp.dir.lib.system", value: dirSystem ?: "")
									}
									
									log.info "Contexto de C/C++ generado exitosamente en Groovy para el entorno: ${env}"
									} else {
										log.info ( "Skipping the execution.\n" )
									}
								]]></script>
							</scripts>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<configuration>
					<skip>${skip.if.not.source}</skip>
				</configuration>
				<executions>
					<execution>
						<id>prepare-tests</id>
						<phase>generate-test-sources</phase>
						<configuration>
							<target name="prepare-context-for-tests">
								<mkdir dir="${project.basedir}/target/test-nar/results"/>
								<mkdir dir="${project.basedir}/target/test-nar/internal"/>
								<propertyfile file="${project.basedir}/target/test-nar/internal/test.properties">
									<entry key="project.basedir" value="${project.basedir}"/>
									<entry key="project.build.directory" value="${project.build.directory}"/>
									<entry key="project.build.testDirectory" value="${gjs.nar.build.testReportsDirectory}"/>
								</propertyfile>
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
					
					<execution>
						<id>check</id>
						<!-- NO usar 'validate': el contexto C/C++ (cpp.dir.lib.*) lo genera el script
						     Groovy de gmavenplus en 'initialize', que va despues. Vale cualquier fase
						     posterior a 'initialize'; se elige una explicita para no depender del orden
						     de declaracion de los plugins dentro de una misma fase. -->
						<phase>process-sources</phase>
						<configuration>
							<target name="execute-cppcheck" if="${cpp.check.execute}">
								<!-- El contexto se lee del fichero, no de las propiedades que gmavenplus inyecta
								     en el modelo de Maven: asi la dependencia es explicita y el check se puede
								     relanzar suelto (mvn antrun:run@check) tras un build. -->
								<available file="${project.build.directory}/custom/compile-context.properties" property="cpp.check.context.available"/>
								<fail unless="cpp.check.context.available" message="Falta ${project.build.directory}/custom/compile-context.properties: el script Groovy de gmavenplus (fase initialize) no se ha ejecutado."/>
								<property file="${project.build.directory}/custom/compile-context.properties"/>
								<mkdir dir="${project.basedir}/target/check"/>
								<!-- El informe NO puede ir a target/check: ahi vive la cache .a1 de
								     cppcheck-build-dir, que no es un informe sino datos de analisis. -->
								<mkdir dir="${cpp.check.report.dir}"/>
								<!-- Macros predefinidos del compilador. cppcheck no los conoce, y sin ellos el
								     preprocesado se va al traste: las cabeceras de Cygwin deciden el tipo de
								     intptr_t con __INTPTR_TYPE__ y sin el disparan un #error que ABORTA el
								     analisis del fichero (de ahi los "0 avisos" enganosos). El compilador y el
								     lenguaje salen de las mismas propiedades que usa la compilacion real, asi
								     que esto se ajusta solo a C/C++ y al modo (gcc de Cygwin o de MinGW).
								     El fichero vacio hace de /dev/null, que no existe en Windows puro. -->
								<touch file="${project.basedir}/target/check/empty.c"/>
								<exec executable="${cpp.compiler}" output="${project.basedir}/target/check/compiler-defines.h" failonerror="false">
									<arg value="-dM"/>
									<arg value="-E"/>
									<arg value="-x"/>
									<arg value="${cpp.compiler.language}"/>
									<arg value="${project.basedir}/target/check/empty.c"/>
								</exec>
								<exec executable="${cpp.check}" dir="${project.basedir}/src/main/${gjs.source.language}" failonerror="false">
									<arg value="--language=${cpp.compiler.language}"/>
									<arg value="--include=${project.basedir}/target/check/compiler-defines.h"/>
									<!-- Los mismos -D de plataforma que recibe el compilador (CYGWIN_POSIX /
									     CYGWIN_WIN), para que se analicen las ramas WIN/POSIX que se compilan
									     de verdad. Por defecto esta vacio, y vacio no anade ningun argumento. -->
									<arg line="${cpp.platform.options}"/>
									<!-- TODO: Asegurar que cppcheck es la última version -->
									<arg value="--std=${cpp.language.standard}"/>
									<arg value="--platform=native"/>
									<arg value="--enable=${cpp.check.severity}"/>
									<arg value="--max-configs=${cpp.check.configurations}"/>
									<arg value="-I${project.basedir}/src/main/include"/>
									<arg value="-I${glibDirInclude}"/>
									<arg value="-I${sslDirInclude}"/>
									<arg value="-I${oraDirInclude}"/>
									<arg value="-I${xmlDirInclude}"/>
									<!-- NO se le dan al check las cabeceras del sistema ( antes entraban aqui las
									     ${cpp.dir.include.options} del contexto ). cppcheck no las necesita: se
									     apoya en sus propios .cfg, y las reales le hacen mas mal que bien.
									
									     Medido el 2026-09-15 sobre gjs-cpp-common-support:
									
									       - con las de MinGW  : ABORTA. psdk_inc/intrin-impl.h:599 le rompe el
									                             preprocesado ( __INTRINSIC_PROLOG ).
									       - con las de Cygwin : funciona, pero mete avisos de ficheros que no son
									                             nuestros ( 8 en modo WIN, 31 en POSIX ), y encima
									                             en modo WIN son las cabeceras de la plataforma
									                             equivocada: el build usa MinGW.
									       - sin ninguna        : 92 avisos, los mismos en WIN que en POSIX, sin
									                             ruido y sin abortar.
									
									     Esto solo se puede hacer desde que Precompilacion.h saca el tamano de
									     puntero de __SIZEOF_POINTER__ y no de INTPTR_MAX: mientras dependia de
									     <stdint.h>, quitarle los includes hacia saltar su #error y el analisis del
									     fichero moria en silencio. Las -I de las librerias externas de aqui arriba
									     ( glib, ssl, oracle, xml ) se quedan: esas si son codigo que analizamos. -->
									<arg value="--suppress=virtualCallInConstructor"/>
									<arg value="--suppress=uninitMemberVar"/>		
									<arg value="--suppress=useInitializationList"/>		
									<arg value="--suppress=toomanyconfigs"/>
									<!-- Las cabeceras estandar que falten se quedan en un aviso informativo:
									     cppcheck se apoya en sus ficheros .cfg, no en los headers reales. No
									     hay que darle los del propio compilador (el include de gcc ni los de
									     libstdc++): rompen el analisis por include_next y __has_builtin. -->
									<arg value="--suppress=missingIncludeSystem"/>
									<!-- OJO: suppress usa el formato id:fichero:linea, y parte por ':'. Una
									     ruta Windows con letra de unidad (C:/...) rompe el parseo y aborta
									     cppcheck, asi que los patrones van sin unidad: *:*/ruta/* -->
									<arg value="--suppress=*:*/instantclient_*/sdk/include/*"/>
									<arg value="--cppcheck-build-dir=${project.basedir}/target/check"/>
									<!-- Con la opcion xml TODOS los avisos van al fichero: ya no salen por
									     consola. La via de consulta pasa a ser el informe HTML de mas abajo. -->
									<arg value="--xml"/>
									<arg value="--output-file=${cpp.check.report.dir}/cppcheck.xml"/>
									<!-- arg value="++check-config" /-->
									<arg value="." />
								</exec>
								<!-- Informe navegable a partir del XML: index.html con los avisos agrupados
								     por fichero, una pagina por fichero con el fuente resaltado y la linea
								     marcada, y stats.html con el desglose por severidad. -->
								<exec executable="${cpp.check.python}" failonerror="false">
									<arg value="${cpp.check.report}"/>
									<arg value="--file=${cpp.check.report.dir}/cppcheck.xml"/>
									<arg value="--report-dir=${cpp.check.report.dir}/html"/>
									<arg value="--source-dir=${project.basedir}/src/main/${gjs.source.language}"/>
									<arg value="--title=${project.artifactId}"/>
								</exec>
							</target>
						</configuration>
						<goals>
							<goal>run</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<profiles>
		<profile>
			<id>cpp</id>
			<activation>
				<!-- Activo siempre -->
				<file>
					<exists>${basedir}/pom.xml</exists>
				</file>
			</activation>
		</profile>
		<profile>
			<id>win</id>
			<activation>
                <property>
					<name>!env.CYGWIN</name>
				</property>
				<os>
					<family>Windows</family>
				</os>
			</activation>
            <properties>
				<platformOptions>-DWIN</platformOptions>
				<gjs.nar.toolchain.prefix>x86_64-w64-mingw32-</gjs.nar.toolchain.prefix>
				<gjs.nar.architecture>x86_64-w64-mingw32</gjs.nar.architecture>
				<gjs.nar.emulation>i386pep</gjs.nar.emulation>
				<platformLinkOptions></platformLinkOptions>
            </properties>
		</profile>
		<profile>
			<id>cygwin</id>
			<activation>
                <property>
					<name>env.CYGWIN</name>
				</property>
				<os>
					<family>Windows</family>
				</os>
			</activation>
            <properties>
				<platformOptions>-DCYGWIN -DPOSIX</platformOptions>
				<gjs.nar.toolchain.prefix></gjs.nar.toolchain.prefix>
				<gjs.nar.architecture>x86_64-pc-cygwin</gjs.nar.architecture>
				<gjs.nar.emulation>i386pep</gjs.nar.emulation>
				<platformLinkOptions></platformLinkOptions>
           </properties>
		</profile>
		<profile>
			<id>unix</id>
			<activation>
				<os>
					<family>Unix</family>
				</os>
			</activation>
            <properties>
				<platformOptions>-DPOSIX</platformOptions>
				<gjs.nar.toolchain.prefix></gjs.nar.toolchain.prefix>
				<gjs.nar.architecture>x86_64-pc-linux-gnu</gjs.nar.architecture>
				<gjs.nar.emulation>elf_x86_64</gjs.nar.emulation>
				<platformLinkOptions></platformLinkOptions>
            </properties>
		</profile>
		<profile>
			<id>cppcheck</id>
			<properties>
				<cpp.check.execute>true</cpp.check.execute>
			</properties>
		</profile>
		<profile>
			<id>deploy-central</id>
			<!-- Central exige un -sources.jar por cada artefacto que no sea pom. Aqui no
			     sirve maven-source-plugin: trabaja sobre los compileSourceRoots de Java, y
			     estos modulos no tienen ni un .java (el jar principal del packaging nar sale
			     vacio, solo con el MANIFEST). Se empaquetan las fuentes de verdad, que ademas
			     es lo util: los depuradores y los IDE las buscan. El -javadoc.jar se genera
			     con Doxygen, que es el equivalente aqui. -->
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-antrun-plugin</artifactId>
						<executions>
							<execution>
								<id>doxygen</id>
								<phase>prepare-package</phase>
								<goals>
									<goal>run</goal>
								</goals>
								<configuration>
									<target xmlns:if="ant:if">
										<!-- Sin fuentes, doxygen genera igualmente sus 17 ficheros de
										     plantilla (css, js, index) y sale con 0: skipIfEmpty no
										     salvaria al jar. Por eso los parents de este arbol, que
										     heredan la ejecucion y no tienen src/main, se descartan
										     aqui con if:set (atributo de Ant, no de antrun). -->
										<available file="${project.basedir}/src/main/${gjs.source.language}" type="dir" property="cpp.doxygen.fuentes"/>
										<mkdir if:set="cpp.doxygen.fuentes" dir="${cpp.doxygen.dir}"/>
										<!-- A POSIX: ver la nota de cpp.cygpath en las propiedades. -->
										<exec if:set="cpp.doxygen.fuentes" executable="${cpp.cygpath}" outputproperty="cpp.doxygen.dir.posix" failonerror="true">
											<arg value="-u"/>
											<arg value="${cpp.doxygen.dir}"/>
										</exec>
										<exec if:set="cpp.doxygen.fuentes" executable="${cpp.cygpath}" outputproperty="cpp.doxygen.fuentes.posix" failonerror="true">
											<arg value="-u"/>
											<arg value="${project.basedir}/src/main/${gjs.source.language}"/>
										</exec>
										<exec if:set="cpp.doxygen.fuentes" executable="${cpp.cygpath}" outputproperty="cpp.doxygen.include.posix" failonerror="true">
											<arg value="-u"/>
											<arg value="${project.basedir}/src/main/include"/>
										</exec>
										<!-- Doxyfile parcial: lo que no aparece toma el valor por defecto.
										     Las dos INPUT van con += y no en la misma linea, para no
										     depender de que ninguna ruta lleve espacios. Las propiedades
										     .posix las resuelve Ant, no Maven: Maven las deja literales
										     por no conocerlas, igual que en el bloque de gcovr. -->
										<echo if:set="cpp.doxygen.fuentes" file="${cpp.doxygen.dir}/Doxyfile">PROJECT_NAME           = "${project.artifactId}"
											PROJECT_NUMBER         = ${project.version}
											PROJECT_BRIEF          = "${project.description}"
											OUTPUT_DIRECTORY       = ${cpp.doxygen.dir.posix}
											INPUT                  = ${cpp.doxygen.fuentes.posix}
											INPUT                 += ${cpp.doxygen.include.posix}
											RECURSIVE              = YES
											OPTIMIZE_OUTPUT_FOR_C  = ${cpp.doxygen.optimize.c}
											EXTRACT_ALL            = YES
											EXTRACT_STATIC         = YES
											GENERATE_HTML          = YES
											GENERATE_LATEX         = NO
											WARN_IF_UNDOCUMENTED   = NO
											QUIET                  = YES
										</echo>
										<!-- El Doxyfile si puede ir en estilo Windows: esa ruta la abre
										     el runtime de Cygwin, no el canonizador de doxygen. -->
										<exec if:set="cpp.doxygen.fuentes" executable="${cpp.doxygen}" failonerror="true">
											<arg value="${cpp.doxygen.dir}/Doxyfile"/>
										</exec>
									</target>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-jar-plugin</artifactId>
						<executions>
							<execution>
								<id>attach-sources</id>
								<phase>package</phase>
								<goals>
									<goal>jar</goal>
								</goals>
								<configuration>
									<classifier>sources</classifier>
									<!-- maven-jar-plugin solo admite una raiz, asi que se toma src/main
									     entera y se filtra: el lenguaje (c o c++, segun gjs.source.language,
									     que gjs-c-parent y gjs-cpp-parent ya distinguen) y las cabeceras
									     publicas. src/main/resources se queda fuera a proposito. -->
									<classesDirectory>${project.basedir}/src/main</classesDirectory>
									<includes>
										<include>${gjs.source.language}/**</include>
										<include>include/**</include>
									</includes>
									<!-- Los parents de este arbol heredan tambien esta ejecucion, y una
									     <execution> con <phase> se ejecuta aunque el packaging sea pom.
									     Sin esto adjuntarian un sources.jar vacio. -->
									<skipIfEmpty>true</skipIfEmpty>
								</configuration>
							</execution>
							<execution>
								<id>attach-javadoc</id>
								<phase>package</phase>
								<goals>
									<goal>jar</goal>
								</goals>
								<configuration>
									<classifier>javadoc</classifier>
									<classesDirectory>${cpp.doxygen.dir}/html</classesDirectory>
									<!-- Donde no corrio doxygen, este directorio no existe. -->
									<skipIfEmpty>true</skipIfEmpty>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
</project>