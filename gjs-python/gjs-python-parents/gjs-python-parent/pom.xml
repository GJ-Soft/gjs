<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.gjsoft</groupId>
		<artifactId>gjs-no-java-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../../../gjs-no-java-parent</relativePath>
	</parent>	

    <groupId>org.gjsoft.python</groupId>
    <artifactId>gjs-python-parent</artifactId>
	<packaging>pom</packaging>

	<name>GJS common Python base parent</name>
	<description>
		Maven Python general parent pom.
		.
		.	Pom organization:
		.
		.	gjs-parent
		.	   └── gjs-no-java-parent
		.				└── gjs-python-parent
		.					   ├── gjs-python-lib-base-parent
		.					   │       └── gjs-python-lib-parent
		.					   └── gjs-python-exe-parent
		.							   └── gjs-python-rest-parent
		.
		Fase Maven			Comando python equivalente
		initialize			
		compile				pip install
		test				python -m pytest
		package				python -m build
		install				pip install
		
		Profiles:
		* upgrade	
		* cobertura	
		
		Install libraries:
			mvn clean initialize -Pupgrade
			mvn exec:exec@upgrade-tools -Pupgrade
	</description>

	<properties>
		<!-- Default programming language features -->
		<gjs.source.language>python</gjs.source.language>
		<gjs.source.extension>py</gjs.source.extension>
		
		<!-- Python/Pip configuration -->
		<gjs.python.subdir.source>src/main/python</gjs.python.subdir.source>
		<gjs.python.subdir.source.test>src/test/python</gjs.python.subdir.source.test>

		<gjs.python.dir.src>${project.build.outputDirectory}</gjs.python.dir.src>
		<gjs.python.dir.test>${project.build.testOutputDirectory}</gjs.python.dir.test>
		<gjs.python.dir.libs>${project.build.directory}/python-libs</gjs.python.dir.libs>
		<gjs.python.dir.eggs>${project.build.directory}/python-eggs</gjs.python.dir.eggs>
		<gjs.python.artifact.src.package.path>org/gjs/python</gjs.python.artifact.src.package.path>
		<!-- No se firma lo que no se publica. Estos artefactos quedan fuera del bundle
		     de Central por el excludeArtifacts del perfil deploy-central en gjs-parent,
		     asi que firmarlos seria trabajo tirado: son 25 modulos y gpg tarda. Es el
		     hermano del <skip> del maven-deploy-plugin que hay mas abajo, y como aquel,
		     provisional: si algun dia estos artefactos se publican, quitar los dos. -->
		<gpg.skip>true</gpg.skip>

		<!-- Sonar -->
		<sonar.python.version>3.14</sonar.python.version>
		<!-- Coding style: No permitimos que cuatro lumbreras decidan como codificar --> 
        <sonar.issue.ignore.multicriteria>p1,p2</sonar.issue.ignore.multicriteria>
		<sonar.issue.ignore.multicriteria.p1.ruleKey>python:S117</sonar.issue.ignore.multicriteria.p1.ruleKey>
		<sonar.issue.ignore.multicriteria.p1.resourceKey>**/*.py</sonar.issue.ignore.multicriteria.p1.resourceKey>
		<sonar.issue.ignore.multicriteria.p2.ruleKey>python:S1542</sonar.issue.ignore.multicriteria.p2.ruleKey>
		<sonar.issue.ignore.multicriteria.p2.resourceKey>**/*.py</sonar.issue.ignore.multicriteria.p2.resourceKey>

		<!-- Dependency versions -->
		<!-- Gjs versions -->
		<gjs-python-common.version>1.0.0</gjs-python-common.version>
	</properties>
	
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.gjsoft.python.common</groupId>
				<artifactId>gjs-python-common</artifactId>
				<version>${gjs-python-common.version}</version>
				<type>whl</type>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<artifactId>maven-dependency-plugin</artifactId>
					<executions>
						<execution>
							<id>copy-whl-dependencies</id>
							<phase>generate-sources</phase>
							<goals>
								<goal>copy-dependencies</goal>
							</goals>
							<configuration>
								<outputDirectory>${gjs.python.dir.libs}</outputDirectory>
								<includeTypes>whl</includeTypes>
								<stripVersion>false</stripVersion>
								<useBaseVersion>false</useBaseVersion>
								<overWriteReleases>true</overWriteReleases>
								<overWriteSnapshots>true</overWriteSnapshots>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<artifactId>maven-resources-plugin</artifactId>
					<executions>
						<execution>
							<id>copy-python-sources</id>
							<phase>generate-resources</phase>
							<goals>
								<goal>copy-resources</goal>
							</goals>
							<configuration>
								<outputDirectory>${gjs.python.dir.src}</outputDirectory>
								<changeDetection>always</changeDetection>
								<resources>
									<!-- setup.py se filtra aparte para que la versión le llegue resuelta
									     desde el pom, que es su única fuente. El resto no se filtra: el
									     código Python puede llevar llaves y no debe tocarse. -->
									<resource>
										<directory>${project.basedir}</directory>
										<includes>
											<include>setup.py</include>
										</includes>
										<filtering>true</filtering>
									</resource>
									<resource>
										<directory>${project.basedir}</directory>
										<includes>
											<include>src/**</include>
											<include>pyproject.toml</include>
										</includes>
										<excludes>
											<exclude>src/test/**</exclude>
											<exclude>src/main/resources/**</exclude>
										</excludes>
									</resource>
								</resources>
							</configuration>
						</execution>
						<execution>
							<id>copy-python-test-sources</id>
							<phase>generate-test-resources</phase>
							<goals>
								<goal>copy-resources</goal>
							</goals>
							<configuration>
								<outputDirectory>${gjs.python.dir.test}</outputDirectory>
								<changeDetection>always</changeDetection>
								<resources>
									<resource>
										<directory>${gjs.python.dir.src}</directory>
										<includes>
											<include>**/**</include>
										</includes>
										<excludes>
											<exclude>build/**</exclude>
										</excludes>
									</resource>
								</resources>
							</configuration>
						</execution>
						<execution>
							<id>copy-python-test-resources</id>
							<phase>generate-test-resources</phase>
							<goals>
								<goal>copy-resources</goal>
							</goals>
							<configuration>
								<changeDetection>always</changeDetection>
								<outputDirectory>${gjs.python.dir.test}</outputDirectory>
								<resources>
									<resource>
										<directory>${project.basedir}</directory>
										<includes>
											<include>src/test/**</include>
										</includes>
									</resource>
								</resources>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<executions>
						<execution>
							<id>python-rename-whl-dependencies</id>
							<phase>process-sources</phase>
							<goals>
								<goal>exec</goal>
							</goals>
							<configuration>
								<executable>python</executable>
								<arguments>
									<argument>-c</argument>
									<argument>import glob, os, re; [os.rename(w, os.path.join(os.path.dirname(w), re.sub(r'^(.+?)-(\d+.*)\.whl$', lambda m: m.group(1).replace('-','_') + '-' + m.group(2).replace('-SNAPSHOT','.dev0').replace('-RC.','rc').replace('-','.') + '-py3-none-any', os.path.basename(w)) + '.whl')) for w in glob.glob(r'${gjs.python.dir.libs}/*.whl') if not os.path.basename(w).endswith('none-any.whl')]</argument>								</arguments>
							</configuration>
						</execution>
						<execution>
							<id>python-compile</id>
							<phase>compile</phase>
							<goals>
								<goal>exec</goal>
							</goals>
							<configuration>
								<executable>python</executable>
								<workingDirectory>${gjs.python.dir.src}</workingDirectory>
								<arguments>
								<!--
								    TODO: Hay un bug en 3.14.2 con compileall 
									<argument>-m</argument>
									<argument>compileall</argument>
									<argument>.</argument>
									-->
									<argument>-c</argument>
									<argument>import compileall, sys; [compileall.compile_file(f, force=True, quiet=1) for f in __import__('pathlib').Path(sys.argv[1]).rglob('*.py')]</argument>
									<argument>${gjs.python.dir.src}</argument>
								</arguments>
							</configuration>
						</execution>
						<execution>
							<id>python-test-source-dependencies</id>
							<phase>process-test-sources</phase>
							<goals>
								<goal>exec</goal>
							</goals>
							<configuration>
								<executable>python</executable>
								<arguments>
									<argument>-c</argument>
									<argument>import zipfile,pathlib,shutil;t=pathlib.Path(r'${gjs.python.dir.test}/${gjs.python.subdir.source}');[zipfile.ZipFile(w).extractall(t) for w in pathlib.Path(r'${gjs.python.dir.libs}').glob('*.whl')];[shutil.rmtree(d) for d in t.glob('*.dist-info')]</argument>
								</arguments>
							</configuration>
						</execution>
						<execution>
							<id>python-test-dependencies</id>
							<phase>process-test-sources</phase>
							<goals>
								<goal>exec</goal>
							</goals>
							<configuration>
								<executable>python</executable>
								<arguments>
									<argument>-c</argument>
									<!-- Las dependencias del propio modulo ( requirements.txt ) tambien:
									     el codigo que se prueba las importa. Antes solo llegaban por el
									     pip install . de la fase install, al Python global, asi que en
									     una maquina limpia los tests fallaban la primera vez. En una sola
									     llamada, para que pip resuelva las dos listas juntas.
									     Sin borrar los *.dist-info: esto no se empaqueta, y hay paquetes
									     que leen su propia version de ahi ( pluggy desde la 1.7, y sin
									     ella pytest muere al arrancar con PackageNotFoundError ). -->
									<argument>import pathlib,subprocess,sys;t=pathlib.Path(r'${gjs.python.dir.test}/${gjs.python.subdir.source}');t.mkdir(parents=True,exist_ok=True);b=pathlib.Path(r'${project.basedir}');rs=[x for n in ('requirements.txt','requirements-test.txt') for x in ('-r',str(b/n)) if (b/n).exists()];subprocess.check_call([sys.executable,'-m','pip','install','--target',str(t),*rs]) if rs else None</argument>
								</arguments>
							</configuration>
						</execution>
						<execution>
							<id>python-test</id>
							<phase>test</phase>
							<goals>
								<goal>exec</goal>
							</goals>
							<configuration>
								<skip>${skipTests}</skip>
								<executable>python</executable>
								<workingDirectory>${gjs.python.dir.test}</workingDirectory>
								<arguments>
									<argument>-m</argument>
									<argument>pytest</argument>
									<argument>--junitxml=${project.build.directory}/surefire-reports/python-tests.xml</argument>
								</arguments>
								<environmentVariables>
									<MAVEN_TEST_PHASE>true</MAVEN_TEST_PHASE>
									<!-- Lo que instala requirements-test.txt va a esta carpeta de la copia,
									     que al arrancar no esta en el sys.path: sin esto, python -m pytest
									     cogeria el pytest global de la maquina, y sin el no arrancaria. -->
									<PYTHONPATH>${gjs.python.dir.test}/${gjs.python.subdir.source}</PYTHONPATH>
								</environmentVariables>
							</configuration>
						</execution>
						<execution>
							<id>python-package</id>
							<phase>prepare-package</phase>
							<goals>
								<goal>exec</goal>
							</goals>
							<configuration>
								<executable>python</executable>
								<workingDirectory>${gjs.python.dir.src}</workingDirectory>
								<arguments>
									<argument>-m</argument>
									<argument>build</argument>
									<argument>--outdir</argument>
									<argument>${project.build.directory}</argument> 
								</arguments>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.codehaus.gmavenplus</groupId>
					<artifactId>gmavenplus-plugin</artifactId>
					<executions>
						<execution>
							<phase>initialize</phase>
							<goals>
								<goal>execute</goal>
							</goals>
							<configuration>
								<scripts>
									<script><![CDATA[
										// Control skipTests:
										// 1. Leemos los valores actuales (vengan del padre o de la consola)
										def skipGlobal = project.properties['skip.if.not.source'] ?: 'false'
										def skipTests = session.userProperties['skipTests'] ?: project.properties['skipTests'] ?: 'false'

										// 2. Aplicamos tu regla: si skipSource es true, eso va a misa
										if (skipGlobal == 'true') {
											log.info("[INPUT] skip.if.not.source es TRUE. Forzando skip de tests.")
											project.properties['maven.test.skip'] = 'true'
											project.properties['skipTests'] = 'true'
										} else if (skipTests == 'true') {
											// Si skipSource es false, respetamos lo que pida skipTests
											log.info("[INPUT] skipTests es TRUE. Saltando tests de forma normal.")
											project.properties['skipTests'] = 'true'
										}

										// 3. Adaptacion de finalName si es necesario
										if (skipGlobal == 'false') { 
											// Final name:
											def artifactId = project.artifactId
											def version = project.version

											project.properties['gjs.python.finalName.artifact'] = artifactId.replace('-', '_')
											project.properties['gjs.python.finalName.version'] = version
												.replace('-SNAPSHOT', '.dev0')
												.replace('-RC.', 'rc')
												.replace('-', '.')
										}
									]]></script>
								</scripts>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>		

		<plugins>
			<plugin>
			   <groupId>org.apache.maven.plugins</groupId>
			   <artifactId>maven-deploy-plugin</artifactId>
			   <configuration>
				  <skip>true</skip>
			   </configuration>
			</plugin>		
			<plugin>
				<artifactId>maven-dependency-plugin</artifactId>
				<configuration>
					<skip>${skip.if.not.source}</skip>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<configuration>
					<skip>${skip.if.not.source}</skip>
				</configuration>
            </plugin>
			<plugin>
				<groupId>org.codehaus.gmavenplus</groupId>
				<artifactId>gmavenplus-plugin</artifactId>
			</plugin>
			<!-- La versión que entiende Python no es la de Maven: SNAPSHOT no es
			     PEP 440 y setuptools lo convierte en '.dev0+sanitized.snapshot', que
			     no es lo que espera el renombrado del wheel. Con -DEV sí sale '.dev0'.
			     Las demás formas (-RC.n, final) las normaliza setuptools sola. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>python-version</id>
						<phase>validate</phase>
						<goals>
							<goal>regex-property</goal>
						</goals>
						<configuration>
							<name>gjs.python.version</name>
							<value>${project.version}</value>
							<regex>-SNAPSHOT$</regex>
							<replacement>-DEV</replacement>
							<failIfNoMatch>false</failIfNoMatch>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

    <profiles>
		<profile>
			<id>python</id>
			<activation>
				<!-- Activo siempre -->
				<file>
					<exists>${basedir}/pom.xml</exists>
				</file>
			</activation>
		</profile>
		<!-- Cobertura de los tests ( mvn -Pcobertura test ), con el mismo convenio que
		     JaCoCo en Java: los datos en bruto en target/coverage.data y el informe en
		     target/site/coverage ( index.html para leerlo, coverage.xml para Sonar ).
		     Se mide sobre la copia de target/test-classes, donde corren los tests, y
		     solo los ficheros del propio modulo: en esa copia estan tambien las
		     dependencias desempaquetadas y lo que instala requirements-test.txt. Las
		     rutas del informe son relativas al directorio de trabajo de pytest, que
		     replica el arbol del proyecto, asi que son las mismas que las del fuente
		     sin reescribir nada. -->
		<profile>
			<id>cobertura</id>
			<build>
				<pluginManagement>
					<plugins>
						<plugin>
							<groupId>org.codehaus.mojo</groupId>
							<artifactId>exec-maven-plugin</artifactId>
							<executions>
								<!-- pytest-cov se instala aqui y no en requirements-test.txt: solo
								     hace falta al medir. Sin dependencias (no-deps): instalando en un directorio ( target ) pip no
								     mira lo que ya hay en el directorio, y pisaria el pytest instalado
								     con otra version. Los dist-info se quedan, como en
								     python-test-dependencies: pytest encuentra el plugin por ellos. -->
								<execution>
									<id>python-coverage-dependencies</id>
									<phase>process-test-sources</phase>
									<goals>
										<goal>exec</goal>
									</goals>
									<configuration>
										<skip>${skipTests}</skip>
										<executable>python</executable>
										<arguments>
											<argument>-c</argument>
											<argument>import pathlib,subprocess,sys;t=pathlib.Path(r'${gjs.python.dir.test}/${gjs.python.subdir.source}');t.mkdir(parents=True,exist_ok=True);subprocess.check_call([sys.executable,'-m','pip','install','--target',str(t),'--no-deps','pytest-cov','coverage'])</argument>
										</arguments>
									</configuration>
								</execution>
								<execution>
									<id>python-coverage-config</id>
									<phase>process-test-sources</phase>
									<goals>
										<goal>exec</goal>
									</goals>
									<configuration>
										<skip>${skipTests}</skip>
										<executable>python</executable>
										<arguments>
											<argument>-c</argument>
											<argument>import pathlib;b=pathlib.Path(r'${project.basedir}');s=b/r'${gjs.python.subdir.source}';t=pathlib.Path(r'${gjs.python.dir.test}');fs=sorted(p.relative_to(b).as_posix() for p in s.rglob('*.py') if '__pycache__' not in p.parts);(t/'.coveragerc').write_text('[run]\nrelative_files = True\nbranch = True\ndata_file = '+pathlib.Path(r'${project.build.directory}','coverage.data').as_posix()+'\ninclude =\n'+''.join('    '+x+'\n' for x in fs),encoding='utf-8')</argument>
										</arguments>
									</configuration>
								</execution>
								<!-- Sin -p pytest_cov.plugin: pytest-cov se carga solo por su
								     dist-info, y pedirlo ademas a mano lo registra dos veces y pytest
								     no arranca. -->
								<execution>
									<id>python-test</id>
									<configuration>
										<arguments combine.children="append">
											<argument>--cov</argument>
											<argument>--cov-config=.coveragerc</argument>
											<argument>--cov-report=xml:${project.build.directory}/site/coverage/coverage.xml</argument>
											<argument>--cov-report=html:${project.build.directory}/site/coverage</argument>
										</arguments>
									</configuration>
								</execution>
							</executions>
						</plugin>
					</plugins>
				</pluginManagement>
			</build>
		</profile>
		<profile>
            <id>upgrade</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
						<configuration>
							<skip>${skip.if.not.source}</skip>
						</configuration>
                       <executions>
                            <execution>
                                <id>upgrade-tools</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>python</executable>
                                    <arguments>
										<argument>-m</argument> 
										<argument>pip</argument>
										<argument>install</argument>
										<argument>--upgrade</argument>
										<argument>pip</argument>
										<argument>setuptools</argument>
										<argument>wheel</argument>
										<argument>build</argument>
										<argument>pytest</argument>
									</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>upgrade-requirements</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>python</executable>
                                    <arguments>
										<argument>-m</argument>
										<argument>pip</argument>
										<argument>install</argument>
										<argument>-r</argument>
										<argument>requirements.txt</argument>
										<argument>--upgrade</argument>
									</arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>upgrade-requirements-test</id>
                                <phase>initialize</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>python</executable>
                                    <arguments>
										<argument>-m</argument>
										<argument>pip</argument>
										<argument>install</argument>
										<argument>-r</argument>
										<argument>requirements-test.txt</argument>
										<argument>--upgrade</argument>
									</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>       
                </plugins>       
            </build>
        </profile>
    </profiles>

</project>