<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.gjsoft.python</groupId>
		<artifactId>gjs-python-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../gjs-python-parent</relativePath>
	</parent>	

    <artifactId>gjs-python-exe-parent</artifactId>
	<packaging>pom</packaging>

	<name>GJS common Python Exe parent</name>
	<description>
		Maven Python general parent for executables pom.
		.
		.	Pom organization:
		.
		.	gjs-parent
		.	   └── gjs-no-java-parent
		.				└── gjs-python-parent
		.					   └── gjs-python-exe-parent
		.							   └── gjs-python-rest-parent
		.
	</description>

	<properties>
		<gjs.python.artifact.ext>pyz</gjs.python.artifact.ext>
		<gjs.python.artifact.src.path>.</gjs.python.artifact.src.path>
		<gjs.python.artifact.main>Main:main</gjs.python.artifact.main>
		
		<!-- Gjs Python commom libraries -->
		<gjs-python-common.version>1.0.0</gjs-python-common.version>

		<!-- Extensions versions -->
		<whl-maven-extension.version>1.0.0</whl-maven-extension.version>
		<pyz-maven-extension.version>1.0.0</pyz-maven-extension.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.gjsoft.python.common</groupId>
				<artifactId>gjs-python-common</artifactId>
				<version>${gjs-python-common.version}</version>
				<type>whl</type>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.gjsoft.python.common</groupId>
			<artifactId>gjs-python-common</artifactId>
			<type>whl</type>
		</dependency>
	</dependencies>
	
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>exec-maven-plugin</artifactId>
					<executions>
						<execution>
							<id>python-include-dependencies</id>
							<phase>prepare-package</phase>
							<goals>
								<goal>exec</goal>
							</goals>
							<configuration>
								<executable>python</executable>
								<arguments>
									<argument>-c</argument>
									<argument>import zipfile,pathlib,subprocess,sys,shutil;t=pathlib.Path(r'${gjs.python.dir.src}/${gjs.python.subdir.source}');t.mkdir(parents=True,exist_ok=True);[zipfile.ZipFile(w).extractall(t) for w in pathlib.Path(r'${gjs.python.dir.libs}').glob('*.whl')];r=pathlib.Path(r'${project.basedir}/requirements.txt');subprocess.check_call([sys.executable,'-m','pip','install','--target',str(t),'-r',str(r)]) if r.exists() else None;[shutil.rmtree(d) for d in t.glob('*.dist-info')]</argument>
								</arguments>
							</configuration>
						</execution>
						<execution>
							<id>python-package</id>
							<phase>package</phase>
							<goals>
								<goal>exec</goal>
							</goals>
							<configuration self.combine="overvrite">
								<executable>python</executable>
								<workingDirectory>${gjs.python.dir.src}</workingDirectory>
								<arguments>
									<argument>-m</argument>
									<argument>zipapp</argument>
									<argument>${gjs.python.artifact.src.path}</argument> 
									<argument>-o</argument>
									<argument>${project.build.directory}/${project.build.finalName}.${gjs.python.artifact.ext}</argument> 
									<argument>--main</argument>
									<argument>${gjs.python.artifact.main}</argument> 
								</arguments>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>		

		<extensions>
			<extension>
				<groupId>org.gjsoft.maven.extensions</groupId>
				<artifactId>pyz-maven-extension</artifactId>
				<version>${pyz-maven-extension.version}</version>
			</extension>
			<extension>
				<groupId>org.gjsoft.maven.extensions</groupId>
				<artifactId>whl-maven-extension</artifactId>
				<version>${whl-maven-extension.version}</version>
			</extension>
		</extensions>
	</build>

</project>