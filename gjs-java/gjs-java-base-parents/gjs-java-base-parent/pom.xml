<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.gjs</groupId>
        <artifactId>gjs-parent</artifactId>
        <version>1.0.0-RC.1</version>
        <relativePath>../../../gjs-parent</relativePath>
    </parent>

    <groupId>org.gjs.java</groupId>
    <artifactId>gjs-java-base-parent</artifactId>
    <packaging>pom</packaging>

    <name>GJS common Java base parent</name>
    <description>
		Maven Java general parent pom.
		.
		.	Pom organization:
		.
		.	gjs-parent
		.		└── gjs-java-base-parent
		.			   ├── gjs-java-parent
		.			   │        └── gjs-java-artifact-parent
		.			   │                   └── gjs-java-web-parent
		.			   │                              ├── gjs-java-war-parent
		.			   │                              ├── gjs-java-springboot-parent
		.			   │                              │           ├── gjs-java-sb-artifact-parent
		.			   │                              │           └── gjs-java-sb-war-parent
		.			   │                              └── gjs-java-sb-test-parent
		.			   ├── gjs-java-maven-base-parent
		.			   │        └── gjs-java-maven-parent
		.			   └── gjs-java-test-base-parent
		.						└── gjs-java-test-parent
		.
		Maven quality, format and documentation commads provided:
			* mvn checkstyle:check 
			* mvn javadoc:javadoc		Generate javadoc site
			* mvn javadoc:fix   		Add or correct Javadoc in src/main/java
			* mvn javadoc:test-fix 		Add or correct Javadoc in src/test/java
			* mvn formatter:format	-Dformatter.file=file-eclipse-likely.xml
			* mvn fmt:format -Dcode.line.max.length=100	
			* mvn spotless:apply   		Apply changes (organize imports)
			* mvn spotless:check   		Just check
			* mvn pmd:check
			* mvn spotbugs:spotbugs
			* mvn spotbugs:check		
			
		Profiles:
			* java                  			         : It is automatically setted
			* attach-sources                	         : Generates sources jar
			* attach-javadoc	            	         : Generates javadoc jar
			* jdk-8 | jdk-11 | jdk-17 | jdk-21 | jdk-25  : Java version

		
		Needs profile cpp with special properties in settings.xml file: 
		
			* jdk25Dir : Directory of Java Jdk-25 installation
		
			* jdk21Dir : Directory of Java Jdk-21 installation
		
			* jdk17Dir : Directory of Java Jdk-17installation
		
			* jdk11Dir : Directory of Java Jdk-11 installation
		
			* jdk8Dir  : Directory of Java Jdk-8 installation
	</description>

    <properties>
        <!-- Default programming language features -->
        <gjs.source.language>java</gjs.source.language>
        <gjs.source.extension>java</gjs.source.extension>

        <!-- Compilation config -->
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>

        <!-- Dependency versions -->
        <!-- Gjs versions -->
        <gjs-java-common-test-base.version>1.0.0-RC.1</gjs-java-common-test-base.version>
        <gjs-java-common-base.version>1.0.0-RC.1</gjs-java-common-base.version>


		<!-- Maven plugins -->
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
		
		<!-- Additional Maven plugins -->
		<formatter-maven-plugin.version>2.29.0</formatter-maven-plugin.version>
		<fmt-maven-plugin.version>2.29</fmt-maven-plugin.version>
		<spotless-maven-plugin.version>2.43.0</spotless-maven-plugin.version>
		<spotbugs-maven-plugin.version>4.9.8.2</spotbugs-maven-plugin.version>
		
        <!-- Apache reporting plugins -->
        <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
        <maven-jxr-plugin.version>3.6.0</maven-jxr-plugin.version>

        <!-- Apache commons-->
        <apache.commons-io.version>2.19.0</apache.commons-io.version>
        <apache.commons-collections.version>4.4</apache.commons-collections.version>
        <apache.commons-text.version>1.14.0</apache.commons-text.version>

        <!-- Xml serialization -->
        <xerces.version>2.12.2</xerces.version>
        <xml-apis.version>2.0.2</xml-apis.version>

        <!-- Logging -->
        <slf4j.version>2.0.17</slf4j.version>
        <logback.version>1.5.21</logback.version>

        <!-- JUnit -->
        <junit-jupiter.version>6.0.1</junit-jupiter.version>
        <junit.version>${junit-jupiter.version}</junit.version>

        <!-- Mockito -->
        <mockito.version>5.20.0</mockito.version>

        <!-- Lombok -->
        <lombok.version>1.18.42</lombok.version>
		
		<!-- Fomatter -->
		<code.line.max.length>120</code.line.max.length>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Gjs -->
            <dependency>
                <groupId>org.gjs.java.common</groupId>
                <artifactId>gjs-java-common-base</artifactId>
                <version>${gjs-java-common-base.version}</version>
            </dependency>

            <!-- Apache commons -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>${apache.commons-io.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>${apache.commons-collections.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>${apache.commons-text.version}</version>
            </dependency>

            <!-- Xml serialization -->
            <dependency>
                <groupId>xerces</groupId>
                <artifactId>xercesImpl</artifactId>
                <version>${xerces.version}</version>
            </dependency>
            <dependency>
                <groupId>xml-apis</groupId>
                <artifactId>xml-apis</artifactId>
                <version>${xml-apis.version}</version>
            </dependency>

            <!-- Lombok Extension -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- Logging -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-core</artifactId>
                <version>${logback.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
                <scope>compile</scope>
            </dependency>

            <!-- Test -->
            <dependency>
                <groupId>org.gjs.java.common</groupId>
                <artifactId>gjs-java-common-test-base</artifactId>
                <version>${gjs-java-common-test-base.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-engine</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-migrationsupport</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-params</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-commons</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-console</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-engine</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-jfr</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-launcher</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-reporting</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-runner</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-suite</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-suite-api</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-suite-commons</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-suite-engine</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-testkit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Logging -->
        <!--
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		-->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Lombok Extension -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-checkstyle-plugin</artifactId>
					<version>${maven-checkstyle-plugin.version}</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-javadoc-plugin</artifactId>
					<executions>
						<execution>
							<id>attach-javadocs</id>
							<goals>
								<goal>javadoc</goal>
								<goal>fix</goal>         <!-- Añade/Arregla Javadoc en código -->
								<goal>test-fix</goal>    <!-- Opcional para tests -->
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-pmd-plugin</artifactId>
					<version>${maven-pmd-plugin.version}</version>
					<configuration>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>net.revelc.code.formatter</groupId>
					<artifactId>formatter-maven-plugin</artifactId>
					<version>${formatter-maven-plugin.version}</version>
					<executions>
						<execution>
							<goals>
								<goal>format</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<configFile>${formatter.file}</configFile>
						<includes>
						   <include>**/*.java</include>
						</includes>
					</configuration>
				</plugin>
				<plugin>
					<groupId>com.spotify.fmt</groupId>
					<artifactId>fmt-maven-plugin</artifactId>
					<version>${fmt-maven-plugin.version}</version>
					<executions>
						<execution>
							<goals>
								<goal>format</goal>
							</goals>
						</execution>
					</executions>
					<configuration>
						<lineLength>${code.line.max.length}</lineLength>
						<includes>
							<include>**/*.java</include>
						</includes>
					</configuration>
				</plugin>
				<plugin>
					<groupId>com.diffplug.spotless</groupId>
					<artifactId>spotless-maven-plugin</artifactId>
					<version>${spotless-maven-plugin.version}</version>
					<configuration>
						<java>
							<removeUnusedImports />
							<importOrder />
						</java>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>apply</goal>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>com.github.spotbugs</groupId>
					<artifactId>spotbugs-maven-plugin</artifactId>
					<version>${spotbugs-maven-plugin.version}</version>
					<configuration>
						<xmlOutput>true</xmlOutput>
						<failOnError>false</failOnError>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>spotbugs</goal>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
		    </plugins>
        </pluginManagement>

        <extensions>
        </extensions>

        <plugins>
        </plugins>

    </build>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jxr-plugin</artifactId>
                <version>${maven-jxr-plugin.version}</version>
            </plugin>
        </plugins>
    </reporting>

    <profiles>
        <profile>
            <id>java</id>
            <activation>
				<!-- Activo siempre -->
				<file>
					<exists>${basedir}/pom.xml</exists>
				</file>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>enforce-environment-ok</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <banDuplicatePomDependencyVersions />
                                        <requireJavaVersion>
                                            <version>${java.version}</version>
                                        </requireJavaVersion>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                            <execution>
                                <id>enforce-jdk-profiles</id>
                                <goals>
                                    <goal>enforce</goal>
                                </goals>
                                <configuration>
                                    <rules>
                                        <requireActiveProfile>
                                            <profiles>jdk-25,jdk-21,jdk-17,jdk-11,jdk-8</profiles>
                                            <all>false</all>
                                        </requireActiveProfile>
                                    </rules>
                                    <fail>true</fail>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>attach-sources</id>
            <build>
                <plugins>
                    <plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-source-plugin</artifactId>
						<executions>
							<execution>
								<id>attach-sources</id>
								<goals>
									<goal>jar-no-fork</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
                    </plugin>
                </plugins>
            </build>
        </profile>		
        <profile>
            <id>attach-javadoc</id>
            <build>
                <plugins>
                    <plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-javadoc-plugin</artifactId>
						<executions>
							<execution>
								<id>attach-javadocs</id>
								<goals>
									<goal>jar</goal>
								</goals>
								<phase>package</phase>
							</execution>
						</executions>
					</plugin>
                </plugins>
            </build>
        </profile>		
        <profile>
            <id>jdk-25</id>
            <properties>
                <!-- Compilation config -->
                <java.version>25</java.version>
                <!-- Jdk -->
                <gjs.java.jdk.dir>${jdk25Dir}</gjs.java.jdk.dir>
            </properties>
        </profile>
        <profile>
            <id>jdk-21</id>
            <activation>
				<jdk>[21.0,)</jdk>
            </activation>
            <properties>
                <!-- Compilation config -->
                <java.version>21</java.version>
                <!-- Jdk -->
                <gjs.java.jdk.dir>${jdk21Dir}</gjs.java.jdk.dir>
            </properties>
        </profile>
        <profile>
            <id>jdk-17</id>
            <activation>
				<jdk>[27.0,21.0)</jdk>
            </activation>
            <properties>
                <!-- Compilation config -->
                <java.version>17</java.version>
                <!-- Jdk -->
                <gjs.java.jdk.dir>${jdk17Dir}</gjs.java.jdk.dir>
            </properties>
        </profile>
        <profile>
            <id>jdk-11</id>
            <activation>
				<jdk>[11.0,17.0)</jdk>
            </activation>
            <properties>
                <!-- Compilation config -->
                <java.version>11</java.version>
                <!-- Jdk -->
                <gjs.java.jdk.dir>${jdk11Dir}</gjs.java.jdk.dir>
            </properties>
        </profile>
        <profile>
            <id>jdk-8</id>
            <activation>
				<jdk>[8.0,11.0)</jdk>
            </activation>
            <properties>
                <!-- Compilation config -->
                <java.version>8</java.version>
                <!-- Jdk -->
                <gjs.java.jdk.dir>${jdk8Dir}</gjs.java.jdk.dir>
            </properties>
        </profile>
    </profiles>
</project>