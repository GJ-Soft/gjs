<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.gjsoft.java</groupId>
		<artifactId>gjs-java-test-parent</artifactId>
		<version>1.0.0</version>    
		<relativePath>../gjs-java-test-parent</relativePath>
	</parent>	

    <artifactId>gjs-java-sb-test-parent</artifactId>
	<packaging>pom</packaging>

	<name>GJS common Java test parent for Spring Boot projects</name>
	<description>
		.
		.	Pom organization:
		.
		.	gjs-parent
		.		└── gjs-java-base-parent
		.			   └── gjs-java-parent
		.			            └── gjs-java-artifact-parent
		.			                       └── gjs-java-web-parent
		.			                                  └── gjs-java-sb-test-parent
		.
	</description>

	<properties>
		<!-- Dependency versions -->
		<!-- Gjs versions -->
		<gjs-java-sb-common-support.version>1.0.0</gjs-java-sb-common-support.version>
		<gjs-java-sb-common.version>1.0.0</gjs-java-sb-common.version>
		<gjs-java-sb-common-test-support.version>1.0.0</gjs-java-sb-common-test-support.version>
		<gjs-java-sb-common-test-mocks.version>1.0.0</gjs-java-sb-common-test-mocks.version>
		<gjs-java-sb-common-test.version>1.0.0</gjs-java-sb-common-test.version>

		<!-- Sprong boot -->
		<springboot.version>3.5.7</springboot.version>
	</properties>
	
    <dependencyManagement>
        <dependencies>
			<dependency>
				<groupId>org.gjsoft.java</groupId>
				<artifactId>gjs-java-web-parent</artifactId>
				<version>1.0.0</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			
			<!-- Spring Boot -->
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${springboot.version}</version> 
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter-test</artifactId>
				<version>${springboot.version}</version>
				<exclusions>
					<exclusion>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-starter-logging</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
		
 			<!-- Gjs -->
			<dependency>
				<groupId>org.gjsoft.java.common</groupId>
				<artifactId>gjs-java-sb-common-support</artifactId>
				<version>${gjs-java-sb-common-support.version}</version>
			</dependency>
			<dependency>
				<groupId>org.gjsoft.java.common</groupId>
				<artifactId>gjs-java-sb-common</artifactId>
				<version>${gjs-java-sb-common.version}</version>
			</dependency>
			
			<!-- Test -->
 			<!-- Gjs -->
			<dependency>
				<groupId>org.gjsoft.java.common</groupId>
				<artifactId>gjs-java-sb-common-test-support</artifactId>
				<version>${gjs-java-sb-common-test-support.version}</version>
				<scope>compile</scope>
			</dependency>
			<dependency>
				<groupId>org.gjsoft.java.common</groupId>
				<artifactId>gjs-java-sb-common-test-mocks</artifactId>
				<version>${gjs-java-sb-common-test-mocks.version}</version>
				<scope>compile</scope>
			</dependency>
			<dependency>
				<groupId>org.gjsoft.java.common</groupId>
				<artifactId>gjs-java-sb-common-test</artifactId>
				<version>${gjs-java-sb-common-test.version}</version>
				<scope>compile</scope>
			</dependency>
		</dependencies>
    </dependencyManagement>

    <dependencies>
		<!-- Spring Boot -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
		</dependency>
	</dependencies>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
					<version>${springboot.version}</version> 
				</plugin>
			</plugins>
		</pluginManagement>		

		<extensions>
		</extensions>
	</build>

</project>