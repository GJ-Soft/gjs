		.
		.	Pom organization:
		.
		.	gjs-parent
		.		└── gjs-java-base-parent
		.			   └── gjs-java-parent
		.			            └── gjs-java-artifact-parent
		.			                       └── gjs-java-web-parent
		.			                                  ├── gjs-java-war-parent
		.			                                  ├── gjs-java-springboot-parent
		.			                                  │           ├── gjs-java-sb-artifact-parent
		.			                                  │           └── gjs-java-sb-war-parent
		.			                                  └── gjs-java-sb-test-parent
		.
	</description>

	<properties>
		<!-- Default programming language features -->
		<gjs.source.language>java</gjs.source.language>
		<gjs.source.extension>java</gjs.source.extension>
		
		<!-- Compilation config -->
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		
		<!-- Dependency versions -->
		<!-- Gjs versions -->
		<gjs-java-common-support.version>1.0.0-RC.2</gjs-java-common-support.version>
		<gjs-java-common-test-support.version>1.0.0-RC.2</gjs-java-common-test-support.version>
		<gjs-java-common-test-mocks.version>1.0.0-RC.2</gjs-java-common-test-mocks.version>
		<gjs-java-common-io.version>1.0.0-RC.2</gjs-java-common-io.version>
		<gjs-java-common.version>1.0.0-RC.2</gjs-java-common.version>
		<gjs-java-common-test.version>1.0.0-RC.2</gjs-java-common-test.version>

		<!-- Jackson -->
		<jackson.version>3.0.3</jackson.version>
		
		<!-- AspectJ -->
		<aspectj.version>1.5.4</aspectj.version>
		
	</properties>
	
	<dependencyManagement>
